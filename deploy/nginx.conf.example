# WorkHub reverse proxy example — Brotli/gzip + static cache
# Adapt for your CDN (Cloudflare, Fastly, CloudFront).

upstream workhub_app {
  server 127.0.0.1:3000;
  keepalive 32;
}

server {
  listen 443 ssl http2;
  server_name example.com;

  # ssl_certificate ...;
  # ssl_certificate_key ...;

  # Outer ceiling on request bodies. The app caps uploads at 5MB per file and
  # 10 files, but nginx is what stops a multipart body from being streamed into
  # the Node process at all — express.json's 1mb limit does not apply to
  # multipart. Keep this above the app's own limit so the app returns the
  # specific 400, and nginx only catches the genuinely absurd.
  client_max_body_size 64m;
  client_body_timeout 30s;

  # gzip fallback
  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # brotli (requires ngx_brotli)
  # brotli on;
  # brotli_types text/plain text/css application/javascript application/json image/svg+xml;

  location /dist/ {
    proxy_pass http://workhub_app;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location /css/ {
    proxy_pass http://workhub_app;
    add_header Cache-Control "public, max-age=604800";
  }

  location /js/ {
    proxy_pass http://workhub_app;
    add_header Cache-Control "public, max-age=604800";
  }

  location / {
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_pass http://workhub_app;
  }
}
