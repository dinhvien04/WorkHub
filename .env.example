# Server
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# Tailwind CDN: unset = on in development, off in production
# USE_TAILWIND_CDN=0
# USE_TAILWIND_CDN=1

# Optional Redis for distributed rate limits / locks (install ioredis or redis)
# REDIS_URL=redis://127.0.0.1:6379

# Optional ClamAV clamd TCP
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310

# MongoDB (replica set / Atlas recommended when ENABLE_TRANSACTIONS=true)
MONGODB_URI=mongodb://127.0.0.1:27017/workhub

#REQUIRED — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
SESSION_SECRET=

# Content Service secrets (M5)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTENT_INTERNAL_SECRET=replace_with_a_long_random_content_internal_secret
MONGODB_CONTENT_URI=mongodb://127.0.0.1:27017/workhub_content
CONTENT_PORT=3003

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Booking limits
BOOKING_SLOT_MINUTES=30
MAX_BOOKING_HOURS=24
MAX_BOOKING_DAYS_AHEAD=180

# Multi-document transactions (requires replica set). false for local standalone.
ENABLE_TRANSACTIONS=false

# Email (required in production for password reset)
EMAIL_PROVIDER=
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Google OIDC (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Dev/test only mock login without real Google:
ALLOW_GOOGLE_MOCK=0

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Admin must enable TOTP when 1 (or feature flag admin_require_2fa)
ADMIN_REQUIRE_2FA=0

# Platform maintenance (or feature flag kill_switch_platform)
MAINTENANCE_MODE=0

# OpenTelemetry lite (optional OTLP HTTP JSON)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=workhub
# OTEL_TRACES_SAMPLER=0.2

# Payment — production forbids mock providers and JWT webhook secret fallback
GATEWAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=workhub_mock
# ALLOW_MOCK_PAYMENT_PROVIDER=true   # dev/test only; production startup fails if true

# Microservices Configs (M4-M6)
COMMUNICATION_INTERNAL_SECRET=
MONGODB_COMMUNICATION_URI=mongodb://127.0.0.1:27017/workhub_communication
COMMUNICATION_PORT=3002
COMMUNICATION_SERVICE_ENABLED=true
COMMUNICATION_CANARY_PERCENT=100

CONTENT_INTERNAL_SECRET=
MONGODB_CONTENT_URI=mongodb://127.0.0.1:27017/workhub_content
CONTENT_PORT=3003
CONTENT_SERVICE_ENABLED=true
CONTENT_CANARY_PERCENT=100

IDENTITY_INTERNAL_SECRET=
MONGODB_IDENTITY_URI=mongodb://127.0.0.1:27017/workhub_identity
IDENTITY_PORT=3004
IDENTITY_SERVICE_ENABLED=false
IDENTITY_CANARY_PERCENT=0

# —— Identity Service secrets (all REQUIRED in production) ——
# Generate a full set with:
#   npm run keys:generate --workspace=@workhub/identity-service
#
# RS256 access-token signing. Production refuses to boot without a persistent
# key — an ephemeral one would invalidate every token on restart.
IDENTITY_JWT_ACTIVE_KID=
IDENTITY_JWT_PRIVATE_KEY_FILE=
# IDENTITY_JWT_PRIVATE_KEY=            # inline PEM alternative to the file above
# Public halves of outgoing keys, kept verifiable for one token lifetime:
#   IDENTITY_JWT_PREVIOUS_PUBLIC_KEYS=<old-kid>:<base64 PEM>,<older-kid>:<base64 PEM>
IDENTITY_JWT_PREVIOUS_PUBLIC_KEYS=
# Keys listed here are rejected outright, even if still published:
IDENTITY_JWT_RETIRED_KIDS=

# Step-up (pre-auth 2FA) tokens are signed with their own key, never JWT_SECRET.
IDENTITY_PREAUTH_JWT_SECRET=
# Signed double-submit CSRF tokens.
IDENTITY_CSRF_SECRET=
# Peppers the password-reset OTP hash so a leaked token table is not brute-forceable.
PASSWORD_RESET_PEPPER=

# TOTP seeds, encrypted at rest (AES-256-GCM). 64 hex chars.
IDENTITY_TOTP_ENCRYPTION_KEY=
IDENTITY_TOTP_KEY_VERSION=v1
# During rotation keep the outgoing key readable, then run:
#   npm run rotate:totp-keys --workspace=@workhub/identity-service
IDENTITY_TOTP_PREVIOUS_KEYS=
# Accepting unencrypted legacy seeds requires an explicit deadline:
# IDENTITY_TOTP_ALLOW_LEGACY_PLAINTEXT=true
# IDENTITY_TOTP_LEGACY_DEADLINE=2026-12-31T00:00:00.000Z

# Outbox rows holding a secret (verification token, reset OTP) are encrypted at rest.
IDENTITY_OUTBOX_PAYLOAD_ENCRYPTION_KEY=
IDENTITY_OUTBOX_PAYLOAD_KEY_VERSION=v1

# Origins permitted to drive cookie-authenticated mutations.
IDENTITY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Monolith-issued HS256 tokens. Set a deadline and the cutover happens on its
# own; both gateway and identity read these.
IDENTITY_LEGACY_JWT_ENABLED=true
IDENTITY_LEGACY_JWT_DEADLINE=

# Host signup stays on the monolith facade until the Catalog (M7) onboarding saga.
IDENTITY_ALLOW_DIRECT_HOST_REGISTRATION=false

# Gateway token-introspection cache (keyed by SHA-256 of the token).
GATEWAY_TOKEN_CACHE_MAX=5000
GATEWAY_TOKEN_CACHE_TTL_MS=15000

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOW_MOCK_COMPLETE=true           # mount mock-complete route; never in production
# Live Stripe (required when PAYMENT_PROVIDER=stripe in production)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live MoMo (required when PAYMENT_PROVIDER=momo in production)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_REDIRECT_URL=
MOMO_IPN_URL=
MOMO_ENDPOINT=
# Absolute site URL (https required in production; no path/query)
PUBLIC_BASE_URL=http://localhost:3000

# Domain-separated secrets (production: each ≥32 chars, all distinct from JWT_SECRET)
# SESSION_SECRET=
# CSRF_SECRET=
# CHECKIN_TOKEN_SECRET=
# OAUTH_STATE_SECRET=
# ICAL_FEED_SECRET=

# Protect /metrics and /health/details (required-ish in production)
METRICS_AUTH_TOKEN=

# WebAuthn / passkeys — disabled by default; crypto always mandatory when enabled
WEBAUTHN_ENABLED=false
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:3000
# WEBAUTHN_USER_VERIFICATION=required
# Production refuses WEBAUTHN_ENABLED=true without RP_ID/ORIGIN or with STRICT=false
# Keep WEBAUTHN_ENABLED=false until strict registration E2E passes

# Google OIDC (signature verified via google-auth-library)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# ALLOW_GOOGLE_MOCK=1  # test/dev only

# Membership paid subscribe (default off until checkout wired)
# MEMBERSHIP_PAID_ENABLED=false

# Playwright E2E (optional): npm i -D playwright && npx playwright install chromium
# PLAYWRIGHT_SKIP=1
# BASE_URL=http://127.0.0.1:3000
