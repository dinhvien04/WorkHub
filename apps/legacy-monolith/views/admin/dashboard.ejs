<div class="p-6">
    <header class="mb-6">
        <h1 class="wh-section-title">Bảng Điều Khiển Quản Trị</h1>
        <p class="wh-section-sub text-sm mt-1">Theo dõi toàn cảnh sức khỏe hệ thống WorkHub</p>
    </header>

    <div class="wh-card-elevated p-2 mb-6 relative z-50 inline-flex items-center">
        <div class="relative inline-block text-left w-full" id="custom-time-dropdown">
            <button type="button" id="custom-time-btn" class="wh-btn-outline text-sm" aria-haspopup="menu">
                <svg aria-hidden="true" focusable="false" style="width:1rem;height:1rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                <span id="custom-time-text">Tất cả thời gian</span>
            </button>
            <div id="custom-time-menu" class="hidden absolute z-50 mt-2 wh-card-elevated overflow-hidden" style="left:0;width:14rem;">
                <div class="flex flex-col py-2" role="menu">
                    <button type="button" role="menuitem" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold" style="background:transparent;border:0;color:var(--color-primary-text);cursor:pointer;" data-value="all">Tất cả thời gian</button>
                    <button type="button" role="menuitem" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold" style="background:transparent;border:0;color:var(--color-text-soft);cursor:pointer;" data-value="specific">Ngày cụ thể...</button>
                    <button type="button" role="menuitem" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold" style="background:transparent;border:0;color:var(--color-text-soft);cursor:pointer;" data-value="range">Khoảng thời gian...</button>
                </div>
            </div>
        </div>
        <div class="absolute w-0 h-0 overflow-hidden opacity-0 pointer-events-none">
            <input type="date" id="filter-date-1" aria-label="Từ ngày">
            <input type="date" id="filter-date-2" aria-label="Đến ngày">
        </div>
    </div>

    <section class="mb-6">
        <h2 class="wh-sr-only">Số liệu tổng quan</h2>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));gap:1rem;">
            <article class="wh-stat">
                <p class="wh-stat-label">Người dùng</p>
                <p id="stat-users" class="wh-stat-value mt-1">0</p>
            </article>
            <article class="wh-stat">
                <p class="wh-stat-label">Chủ cơ sở</p>
                <p id="stat-hosts" class="wh-stat-value mt-1">0</p>
            </article>
            <article class="wh-stat">
                <p class="wh-stat-label">Chi nhánh</p>
                <p id="stat-branches" class="wh-stat-value mt-1">0</p>
            </article>
            <article class="wh-stat">
                <p class="wh-stat-label">Không gian</p>
                <p id="stat-spaces" class="wh-stat-value mt-1">0</p>
            </article>
            <article class="wh-stat">
                <p class="wh-stat-label">Lượt đặt chỗ</p>
                <p id="stat-bookings" class="wh-stat-value mt-1">0</p>
            </article>
        </div>
    </section>

    <div class="mb-6" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1.5rem;align-items:start;">
        <section class="wh-card-elevated p-5" style="min-width:0;">
            <h2 class="font-bold mb-4" style="color:var(--color-text);">Xu hướng Doanh thu (VND)</h2>
            <canvas id="revenueLineChart" height="100" role="img" aria-label="Biểu đồ đường thể hiện xu hướng doanh thu theo thời gian"></canvas>
        </section>
        <section class="wh-card-elevated p-5" style="min-width:0;">
            <h2 class="font-bold mb-4 flex justify-between items-center gap-2" style="color:var(--color-text);">
                <span>Nhật ký hoạt động</span>
                <a href="/admin/activitylog" class="text-xs font-bold uppercase hover:underline" style="color:var(--color-primary-text);">Xem thêm</a>
            </h2>
            <div id="audit-log-container" class="flex flex-col gap-3 text-sm" style="color:var(--color-text-soft);"></div>
        </section>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:1.5rem;align-items:start;">
        <section class="wh-card-elevated p-5" style="min-width:0;">
            <h2 class="font-bold mb-4" style="color:var(--color-text);">Trạng thái Đơn đặt chỗ</h2>
            <div class="relative flex items-center justify-center w-full" style="height:250px;">
                <canvas id="bookingStatusChart" role="img" aria-label="Biểu đồ tròn phân bổ trạng thái đơn đặt chỗ"></canvas>
            </div>
        </section>
        <section class="wh-card-elevated p-5" style="min-width:0;">
            <h2 class="font-bold mb-4" style="color:var(--color-text);">Top đối tác (Doanh thu)</h2>
            <div id="top-hosts-container" class="flex flex-col gap-2 text-sm" style="color:var(--color-text-soft);"></div>
        </section>
    </div>
</div>
<script src="/socket.io/socket.io.js"></script>
<%/* Chart.js is loaded by layout.ejs when loadChartJs is set, with the CSP
     nonce. The jsdelivr tag that used to sit here carried no nonce, and
     production script-src is only 'self' plus nonce — so it was blocked and
     this dashboard rendered without charts. */%>
