<div class="max-w-2xl mx-auto">
  <header class="mb-6">
    <h1 class="wh-section-title mb-1">CMS</h1>
    <p class="wh-section-sub text-sm">Soạn và xuất bản trang nội dung tại <span style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">/huong-dan/&lt;slug&gt;</span>.</p>
  </header>

  <form id="cms-form" class="wh-card-elevated p-6">
    <div class="mb-4">
      <label for="cms-title" class="wh-label">Tiêu đề</label>
      <input id="cms-title" name="Title" required placeholder="Title" class="wh-field text-sm" />
    </div>

    <div class="mb-4">
      <label for="cms-slug" class="wh-label">Slug</label>
      <input id="cms-slug" name="Slug" placeholder="slug (optional)" class="wh-field text-sm" />
    </div>

    <div class="mb-4">
      <label for="cms-type" class="wh-label">Loại nội dung</label>
      <select id="cms-type" name="Type" class="wh-field text-sm">
        <option value="guide">guide</option>
        <option value="faq">faq</option>
        <option value="policy">policy</option>
        <option value="city">city</option>
        <option value="announcement">announcement</option>
      </select>
    </div>

    <div class="mb-4">
      <label for="cms-body" class="wh-label">Nội dung</label>
      <textarea id="cms-body" name="Body" rows="6" class="wh-field text-sm" placeholder="Nội dung"></textarea>
    </div>

    <div class="mb-4">
      <label for="cms-status" class="wh-label">Trạng thái</label>
      <select id="cms-status" name="Status" class="wh-field text-sm">
        <option value="published">published</option>
        <option value="draft">draft</option>
      </select>
    </div>

    <button class="wh-btn-brand w-full" type="submit">Lưu</button>
    <p id="cms-msg" class="text-xs mt-3" role="status" style="color:var(--color-muted);"></p>
  </form>
</div>
