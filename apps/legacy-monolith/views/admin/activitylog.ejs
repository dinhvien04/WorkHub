<div class="p-6">
    <header class="mb-6">
        <h1 class="wh-section-title">Nhật ký hoạt động</h1>
        <p class="wh-section-sub text-sm mt-1">Dấu vết kiểm toán của mọi thao tác trên hệ thống.</p>
    </header>

    <section class="wh-card-elevated p-4 mb-6 flex flex-wrap items-end gap-4">
        <h2 class="wh-sr-only">Bộ lọc</h2>

        <div class="relative inline-block text-left" id="custom-time-dropdown">
            <button type="button" id="custom-time-btn" class="wh-btn-outline text-sm" aria-haspopup="menu">
                <svg aria-hidden="true" focusable="false" style="width:1rem;height:1rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                <span id="custom-time-text">Tất cả thời gian</span>
            </button>
            <div id="custom-time-menu" class="hidden absolute z-50 mt-2 wh-card-elevated overflow-hidden" style="left:0;width:14rem;">
                <div class="flex flex-col py-2" role="menu">
                    <button type="button" role="menuitem" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold" style="background:transparent;border:0;color:var(--color-primary-text);cursor:pointer;" data-value="all">Tất cả thời gian</button>
                    <button type="button" role="menuitem" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold" style="background:transparent;border:0;color:var(--color-text-soft);cursor:pointer;" data-value="specific">Ngày cụ thể...</button>
                    <button type="button" role="menuitem" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold" style="background:transparent;border:0;color:var(--color-text-soft);cursor:pointer;" data-value="range">Khoảng thời gian...</button>
                </div>
            </div>
        </div>
        <div class="absolute w-0 h-0 overflow-hidden opacity-0 pointer-events-none">
            <input type="date" id="filter-date-1" aria-label="Từ ngày">
            <input type="date" id="filter-date-2" aria-label="Đến ngày">
        </div>

        <div class="flex-1" style="min-width:200px;">
            <label for="filter-keyword" class="wh-label text-xs uppercase tracking-widest">Từ khóa</label>
            <input type="text" id="filter-keyword" class="wh-field text-sm" placeholder="Tìm kiếm theo mô tả, tên, ID...">
        </div>

        <div style="min-width:220px;">
            <label for="filter-entity" class="wh-label text-xs uppercase tracking-widest">Đối tượng</label>
            <select id="filter-entity" class="wh-field text-sm">
                <option value="all">Tất cả đối tượng</option>
                <option value="Booking">Đơn đặt chỗ (Booking)</option>
                <option value="User">Tài khoản (User/Profile)</option>
                <option value="Space">Không gian (Space/Branch)</option>
                <option value="PaymentHistory">Giao dịch (Payment)</option>
            </select>
        </div>
    </section>

    <section class="wh-card-elevated overflow-hidden">
        <h2 class="wh-sr-only">Bảng nhật ký</h2>
        <div class="overflow-x-auto">
            <table class="w-full text-left" style="border-collapse:collapse;min-width:900px;">
                <caption class="wh-sr-only">Nhật ký hoạt động quản trị theo thời gian, người thực hiện, hành động và nội dung</caption>
                <thead>
                    <tr style="background:var(--color-surface-sunken);color:var(--color-text-soft);border-bottom:1px solid var(--color-border);">
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest" style="width:10rem;">Thời gian</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest" style="width:12rem;">Người thực hiện</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest" style="width:10rem;">Hành động</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest" style="min-width:250px;">Nội dung</th>
                    </tr>
                </thead>
                <tbody id="activity-log-table-body" class="text-sm divide-y divide-slate-50">
                    <tr><td colspan="4" class="p-8 text-center font-medium" style="color:var(--color-muted);">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>

        <div class="p-4 flex flex-wrap items-center justify-between gap-3 text-sm font-medium" id="pagination-container" style="border-top:1px solid var(--color-border);color:var(--color-text-soft);">
            </div>
    </section>
</div>
<div id="detail-modal" class="hidden fixed inset-0 z-[100] backdrop-blur-sm flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="modal-title" style="background:rgba(15,23,42,0.5);">
    <div class="wh-card-elevated overflow-hidden w-full max-w-lg" id="detail-modal-content">
        <div class="px-6 py-4 flex justify-between items-center gap-3" style="background:var(--color-surface-sunken);border-bottom:1px solid var(--color-border);">
            <h2 class="text-lg font-black" id="modal-title" style="color:var(--color-text);">Chi tiết hoạt động</h2>
            <button type="button" data-wh-click="closeDetailsModal" aria-label="Đóng chi tiết" class="wh-touch-target inline-flex items-center justify-center" style="background:transparent;border:0;color:var(--color-muted);cursor:pointer;border-radius:var(--radius-full);">
                <svg style="width:1.5rem;height:1.5rem;" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div class="p-6">
            <div id="modal-body" class="flex flex-col gap-4 text-sm" style="color:var(--color-text-soft);">
                </div>
        </div>
        <div class="px-6 py-4 flex justify-end" style="background:var(--color-surface-sunken);border-top:1px solid var(--color-border);">
            <button type="button" data-wh-click="closeDetailsModal" class="wh-btn-outline text-sm">Đóng</button>
        </div>
    </div>
</div>
