<section class="wh-card-elevated p-6">
    <header class="mb-6">
        <h1 class="wh-section-title mb-1">Duyệt Chủ cơ sở</h1>
        <p class="wh-section-sub text-sm">Kiểm duyệt hồ sơ đăng ký và quản lý các đối tác kinh doanh trên hệ thống.</p>
    </header>

    <section class="overflow-hidden" style="border:1px solid var(--color-border);border-radius:var(--radius-lg);">
        <div class="p-4 flex flex-wrap justify-between items-center gap-3" style="background:var(--color-warning-bg);border-bottom:1px solid var(--color-border);">
            <h2 class="text-lg font-bold" style="color:var(--color-warning-text);">Yêu cầu Phê duyệt</h2>
            <span class="wh-chip wh-chip-warning"><span aria-hidden="true">⏳</span> Đang chờ xử lý</span>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left" style="border-collapse:collapse;min-width:760px;background:var(--color-surface);">
                <caption class="wh-sr-only">Hồ sơ chủ cơ sở đang chờ phê duyệt</caption>
                <thead>
                    <tr style="background:var(--color-surface-sunken);color:var(--color-text-soft);border-bottom:1px solid var(--color-border);">
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Người đăng ký</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Thông tin Doanh nghiệp</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Liên hệ</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody id="pending-hosts-body" class="text-sm divide-y divide-slate-100">
                    <tr>
                        <td colspan="4" class="p-8 text-center" style="color:var(--color-muted);">
                            Đang tải danh sách chờ duyệt...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</section>
