<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-black mb-4">Quản lý Dead-Letter Queue (DLQ)</h1>
  <div class="mb-4 flex space-x-2">
    <button id="tab-pending" class="px-4 py-2 font-bold rounded bg-black text-white">Chờ xử lý (Pending)</button>
    <button id="tab-replayed" class="px-4 py-2 font-bold rounded bg-gray-200 text-black">Đã phát lại (Replayed)</button>
    <button id="tab-discarded" class="px-4 py-2 font-bold rounded bg-gray-200 text-black">Đã hủy bỏ (Discarded)</button>
  </div>
  <div id="dlq-list" class="space-y-3"></div>
</div>
