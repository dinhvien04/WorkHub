<div class="max-w-5xl mx-auto" id="admin-listings">
  <header class="mb-6">
    <h1 class="wh-section-title mb-1">Listing moderation</h1>
    <p class="wh-section-sub text-sm">Suspend / restore / request change. Audit + notify host.</p>
  </header>

  <div id="al-msg" class="hidden mb-4 text-sm p-3 rounded-xl border" role="status"></div>

  <section class="wh-card-elevated p-6 mb-6">
    <h2 class="font-bold mb-4" style="color:var(--color-text);">Moderate</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr));gap:0.75rem;">
      <div>
        <label for="al-type" class="wh-label text-xs uppercase tracking-widest">Type</label>
        <select id="al-type" class="wh-field text-sm">
          <option value="branch">branch</option>
          <option value="space">space</option>
        </select>
      </div>
      <div>
        <label for="al-id" class="wh-label text-xs uppercase tracking-widest">Target ID</label>
        <input id="al-id" class="wh-field text-sm" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;" />
      </div>
      <div>
        <label for="al-action" class="wh-label text-xs uppercase tracking-widest">Action</label>
        <select id="al-action" class="wh-field text-sm">
          <option value="suspend">suspend</option>
          <option value="restore">restore</option>
          <option value="approve">approve</option>
          <option value="request_change">request_change</option>
        </select>
      </div>
      <div>
        <label for="al-reason" class="wh-label text-xs uppercase tracking-widest">Reason</label>
        <input id="al-reason" class="wh-field text-sm" />
      </div>
    </div>
    <div class="mt-3">
      <label for="al-note" class="wh-label text-xs uppercase tracking-widest">Note</label>
      <textarea id="al-note" rows="2" class="wh-field text-sm"></textarea>
    </div>
    <button type="button" id="al-submit" class="wh-btn-brand mt-4">Gửi moderation</button>
  </section>

  <section class="wh-card-elevated p-6">
    <div class="flex flex-wrap justify-between items-center gap-3 mb-4">
      <h2 class="font-bold" style="color:var(--color-text);">Flagged / inactive queue</h2>
      <button type="button" id="al-refresh" class="wh-btn-outline text-sm">Refresh</button>
    </div>

    <h3 class="text-xs font-bold uppercase tracking-widest mb-2" style="color:var(--color-muted);">Branches</h3>
    <ul id="al-branches" class="space-y-2 text-sm mb-6" style="list-style:none;padding:0;margin-top:0;color:var(--color-text-soft);"></ul>

    <h3 class="text-xs font-bold uppercase tracking-widest mb-2" style="color:var(--color-muted);">Spaces</h3>
    <ul id="al-spaces" class="space-y-2 text-sm" style="list-style:none;padding:0;margin-top:0;color:var(--color-text-soft);"></ul>
  </section>
</div>
