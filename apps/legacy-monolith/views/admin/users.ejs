<section class="wh-card-elevated p-6">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
            <h1 class="wh-section-title mb-1">Quản lý Người dùng</h1>
            <p class="wh-section-sub text-sm">Xem, tìm kiếm và kiểm soát trạng thái hoạt động của thành viên hệ thống.</p>
        </div>

        <div class="flex flex-wrap items-end gap-3">
            <div style="min-width:16rem;flex:1 1 16rem;">
                <label for="search-user" class="wh-label text-xs uppercase tracking-widest">Tìm kiếm</label>
                <input type="text" id="search-user" class="wh-field text-sm" placeholder="Tìm theo email hoặc tên...">
            </div>
            <div style="min-width:11rem;">
                <label for="filter-role" class="wh-label text-xs uppercase tracking-widest">Vai trò</label>
                <select id="filter-role" class="wh-field text-sm">
                    <option value="all">Tất cả vai trò</option>
                    <option value="customer">Khách hàng</option>
                    <option value="host">Chủ cơ sở</option>
                </select>
            </div>
        </div>
    </div>

    <div class="overflow-hidden" style="border:1px solid var(--color-border);border-radius:var(--radius-lg);">
        <div class="overflow-x-auto">
            <table class="w-full text-left" style="border-collapse:collapse;min-width:720px;">
                <caption class="wh-sr-only">Danh sách người dùng hệ thống với vai trò, trạng thái và hành động quản trị</caption>
                <thead>
                    <tr style="background:var(--color-surface-sunken);color:var(--color-text-soft);border-bottom:1px solid var(--color-border);">
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Họ và tên</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Email</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Vai trò</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest">Trạng thái</th>
                        <th scope="col" class="p-4 text-xs font-bold uppercase tracking-widest text-right">Hành động</th>
                    </tr>
                </thead>
                <tbody id="user-table-body" class="text-sm divide-y divide-slate-100">
                    <tr>
                        <td colspan="5" class="p-8 text-center" style="color:var(--color-muted);">
                            Đang tải danh sách người dùng...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
