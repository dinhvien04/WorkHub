<div class="max-w-3xl mx-auto">
  <header class="mb-6">
    <h1 class="wh-section-title mb-1">SEO redirects</h1>
    <p class="wh-section-sub text-sm">301/302 path redirects + sitemap index.</p>
  </header>

  <section class="wh-card-elevated p-5 mb-4">
    <h2 class="wh-sr-only">Thêm redirect mới</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:0.75rem;">
      <div>
        <label class="wh-label text-xs uppercase tracking-widest" for="seo-from">From path</label>
        <input id="seo-from" class="wh-field text-sm" placeholder="/old-url" />
      </div>
      <div>
        <label class="wh-label text-xs uppercase tracking-widest" for="seo-to">To path</label>
        <input id="seo-to" class="wh-field text-sm" placeholder="/khong-gian" />
      </div>
      <div>
        <label class="wh-label text-xs uppercase tracking-widest" for="seo-code">Status</label>
        <select id="seo-code" class="wh-field text-sm">
          <option value="301">301 permanent</option>
          <option value="302">302 temporary</option>
        </select>
      </div>
      <div>
        <label class="wh-label text-xs uppercase tracking-widest" for="seo-note">Note (optional)</label>
        <input id="seo-note" class="wh-field text-sm" placeholder="legacy slug / campaign" />
      </div>
    </div>
    <button type="button" id="seo-save" class="wh-btn-brand mt-4">Lưu</button>
  </section>

  <p id="seo-msg" class="text-sm mb-3" role="status"></p>

  <section class="wh-card-elevated overflow-hidden mb-4">
    <h2 class="wh-sr-only">Redirect hiện có</h2>
    <div id="seo-list" style="color:var(--color-text-soft);"></div>
  </section>

  <p class="text-xs" style="color:var(--color-muted);">
    Sitemaps:
    <a class="underline" style="color:var(--color-primary-text);" href="/sitemap_index.xml">index</a> ·
    <a class="underline" style="color:var(--color-primary-text);" href="/sitemap-images.xml">images</a> ·
    <a class="underline" style="color:var(--color-primary-text);" href="/robots.txt">robots</a> ·
    <a class="underline" style="color:var(--color-primary-text);" href="/status">status</a>
  </p>
</div>
