<%/* Left navigation. Items are generated by JavaScript from the user's role
     (see public/js/main.js), so the list starts empty.

     aria-busy tells assistive tech the region is still being populated rather
     than genuinely empty; main.js clears it once the menu is rendered. */%>
<aside id="sidebar" class="sidebar hidden-permanent" aria-label="Điều hướng chính">
    <nav class="py-6 flex-grow" aria-label="Menu theo vai trò">
        <div id="menu-items" aria-busy="true"></div>
    </nav>
</aside>
