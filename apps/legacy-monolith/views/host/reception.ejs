<div class="max-w-5xl mx-auto">
  <header class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
      <h1 class="wh-section-title">Reception — Hôm nay</h1>
      <p class="wh-section-sub text-sm">Check-in / check-out · quét QR token hoặc mã <span class="font-mono">WH-xxxxxx</span></p>
    </div>
    <div class="flex gap-3 items-center">
      <span id="rx-count" class="text-xs font-bold text-slate-600" role="status" aria-live="polite"></span>
      <button type="button" id="rx-refresh" class="wh-btn-outline text-xs uppercase tracking-widest">Refresh</button>
    </div>
  </header>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="rx-scan-title">
    <h2 id="rx-scan-title" class="font-black text-lg mb-4">Quét mã khách</h2>
    <div class="flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-[220px]">
        <label for="rx-code" class="wh-label text-xs uppercase tracking-widest">Mã QR token hoặc booking code</label>
        <input id="rx-code" type="text" placeholder="WH-ABC123 hoặc token base64…" autocomplete="off"
          class="wh-field font-mono" />
      </div>
      <button type="button" id="rx-paste" class="wh-btn-outline text-xs uppercase tracking-widest">
        Dán
      </button>
      <button type="button" id="rx-scan-btn" class="wh-btn-brand text-xs uppercase tracking-widest">
        Quét / Check-in
      </button>
      <p id="rx-scan-msg" class="text-sm w-full m-0" role="status" aria-live="polite"></p>
      <p class="text-xs text-slate-600 w-full m-0">Mẹo: khách mở Dashboard → Hiện QR; dán token vào đây hoặc nhập mã WH-.</p>
    </div>
  </section>

  <div id="rx-error" class="error-state hidden mb-4" role="alert"></div>

  <section class="wh-card-gradient overflow-hidden" aria-labelledby="rx-today-title">
    <h2 id="rx-today-title" class="wh-sr-only">Booking hôm nay</h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-xs uppercase font-black text-slate-600 tracking-widest">
          <tr>
            <th scope="col" class="p-3 text-left">Giờ</th>
            <th scope="col" class="p-3 text-left">Phòng</th>
            <th scope="col" class="p-3 text-left">Khách</th>
            <th scope="col" class="p-3 text-left">Mã</th>
            <th scope="col" class="p-3 text-left">TT</th>
            <th scope="col" class="p-3 text-right">Thao tác</th>
          </tr>
        </thead>
        <tbody id="rx-body"></tbody>
      </table>
    </div>
  </section>

  <div class="grid md:grid-cols-2 gap-4 mt-6">
    <section class="wh-card-elevated p-5" aria-labelledby="rx-note-title">
      <h2 id="rx-note-title" class="font-black text-lg mb-1">Ghi chú nội bộ booking</h2>
      <p class="text-xs text-slate-600 mb-3">Chỉ host/staff thấy. Booking ID MongoDB.</p>

      <div class="mb-3">
        <label for="rx-note-booking" class="wh-label text-xs uppercase tracking-widest">Booking ID</label>
        <input id="rx-note-booking" class="wh-field font-mono" />
      </div>
      <div class="mb-3">
        <label for="rx-note-body" class="wh-label text-xs uppercase tracking-widest">Nội dung</label>
        <input id="rx-note-body" maxlength="2000" class="wh-field" placeholder="Ghi chú…" />
      </div>

      <div class="flex gap-2 flex-wrap">
        <button type="button" id="rx-note-load" class="wh-btn-outline text-xs uppercase tracking-widest">Xem</button>
        <button type="button" id="rx-note-add" class="wh-btn-brand text-xs uppercase tracking-widest">Thêm</button>
      </div>
      <ul id="rx-note-list" class="mt-3 space-y-2 text-xs text-slate-600"></ul>
      <p id="rx-note-msg" class="text-sm mt-2 m-0" role="status" aria-live="polite"></p>
    </section>

    <section class="wh-card-elevated p-5" aria-labelledby="rx-inc-title">
      <h2 id="rx-inc-title" class="font-black text-lg mb-1">Báo cáo sự cố (incident)</h2>
      <p class="text-xs text-slate-600 mb-3">damage / late_checkout / violation / other — gắn booking.</p>

      <div class="mb-3">
        <label for="rx-inc-booking" class="wh-label text-xs uppercase tracking-widest">Booking ID</label>
        <input id="rx-inc-booking" class="wh-field font-mono" />
      </div>
      <div class="mb-3">
        <label for="rx-inc-type" class="wh-label text-xs uppercase tracking-widest">Loại</label>
        <select id="rx-inc-type" class="wh-field">
          <option value="damage">damage</option>
          <option value="late_checkout">late_checkout</option>
          <option value="violation">violation</option>
          <option value="other">other</option>
        </select>
      </div>
      <div class="mb-3">
        <label for="rx-inc-desc" class="wh-label text-xs uppercase tracking-widest">Mô tả</label>
        <textarea id="rx-inc-desc" rows="2" class="wh-field"></textarea>
      </div>
      <div class="mb-4">
        <label for="rx-inc-internal" class="wh-label text-xs uppercase tracking-widest">Ghi chú nội bộ (tuỳ chọn)</label>
        <input id="rx-inc-internal" class="wh-field" />
      </div>

      <button type="button" id="rx-inc-submit" class="wh-btn-brand wh-btn-accent text-xs uppercase tracking-widest">Gửi incident</button>
      <p id="rx-inc-msg" class="text-sm mt-2 m-0" role="status" aria-live="polite"></p>
    </section>
  </div>
</div>
