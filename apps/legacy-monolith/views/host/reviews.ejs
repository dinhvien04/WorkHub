<div class="max-w-3xl mx-auto">
  <header class="mb-4">
    <h1 class="wh-section-title">Đánh giá khách</h1>
    <p class="wh-section-sub text-sm">Trả lời review trên listing của bạn. Chỉ host của space mới reply được.</p>
  </header>

  <div class="flex flex-wrap gap-2 mb-4" role="group" aria-label="Lọc đánh giá">
    <button type="button" data-rv-filter="" class="rv-filter wh-chip wh-chip-brand text-xs uppercase tracking-widest cursor-pointer ring-2 ring-teal-500">Tất cả</button>
    <button type="button" data-rv-filter="unreplied" class="rv-filter wh-chip text-xs uppercase tracking-widest cursor-pointer">Chưa reply</button>
    <button type="button" data-rv-filter="reported" class="rv-filter wh-chip text-xs uppercase tracking-widest cursor-pointer">Reported</button>
  </div>

  <div id="rv-msg" class="hidden mb-3 text-sm p-3 rounded-xl border" role="status" aria-live="polite"></div>

  <ul id="rv-list" class="space-y-2"></ul>
</div>
