<div id="space-mgr-layer-1">
  <header class="flex flex-col md:flex-row md:justify-between items-end gap-4 mb-8">
    <div>
      <h1 class="wh-section-title">Quản lý không gian</h1>
      <p class="wh-section-sub text-sm">
        Chọn một cơ sở để bắt đầu quản lý hoặc thêm cơ sở mới
      </p>
    </div>
    <button
      type="button"
      id="btn-start-add-facility"
      data-wh-click="startAddFacility"
      class="wh-btn-brand text-xs uppercase tracking-widest flex-shrink-0"
    >
      <span aria-hidden="true">+</span> Thêm cơ sở
    </button>
  </header>

  <div id="facility-list-grid" class="grid md:grid-cols-2 gap-6">
    <p class="text-slate-600 text-sm">Đang tải danh sách cơ sở...</p>
  </div>
</div>

<%- include('add_facility_wizard') %>

<div id="space-mgr-layer-2" class="hidden">
  <button
    type="button"
    data-wh-click="backToLayer1"
    class="wh-btn-outline mb-6 text-xs uppercase tracking-widest"
  >
    <span aria-hidden="true">←</span> Quay lại danh sách cơ sở
  </button>

  <div class="grid lg:grid-cols-3 gap-8">
    <div class="lg:col-span-1">
      <section class="wh-card-elevated p-6" aria-labelledby="branch-info-title">
        <h2 id="branch-info-title" class="font-black text-xl mb-6 pb-2 border-b">
          Thông tin cơ sở
        </h2>

        <div class="grid gap-4">
          <div>
            <p class="wh-label text-xs uppercase tracking-widest">Ảnh cơ sở hiện tại (Bấm ✕ để xóa)</p>
            <div
              id="branch-main-img-container"
              class="flex flex-wrap gap-2 p-2 border border-slate-200 rounded-2xl min-h-[100px] items-center bg-slate-50"
            ></div>
          </div>

          <div>
            <label
              for="branch-img-input"
              class="wh-label text-xs uppercase tracking-widest cursor-pointer flex flex-col items-center justify-center gap-1 h-20 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-600"
            >
              + Tải ảnh mới lên
              <input
                type="file"
                id="branch-img-input"
                name="image"
                accept="image/*"
                multiple
                class="hidden"
                data-wh-change="previewBranchImagesFromInput" data-wh-this="1"
              />
            </label>
            <div id="branch-selected-preview-container" class="flex flex-wrap gap-2 mt-2"></div>
          </div>

          <div>
            <label for="branch-field-name" class="wh-label text-xs uppercase tracking-widest">Tên cơ sở</label>
            <input
              type="text"
              id="branch-field-name"
              data-fac-field="name"
              class="wh-field"
            />
          </div>
          <div>
            <label for="branch-field-address" class="wh-label text-xs uppercase tracking-widest">Địa chỉ</label>
            <input
              type="text"
              id="branch-field-address"
              data-fac-field="address"
              class="wh-field"
            />
          </div>
          <div>
            <label for="branch-field-note" class="wh-label text-xs uppercase tracking-widest">Ghi chú mô tả</label>
            <textarea
              id="branch-field-note"
              data-fac-field="note"
              rows="3"
              class="wh-field"
            ></textarea>
          </div>

          <button
            type="button"
            data-wh-click="saveBranchInfo"
            class="wh-btn-brand w-full text-xs uppercase tracking-widest"
          >
            Cập nhật cơ sở
          </button>
        </div>
      </section>
    </div>

    <div class="lg:col-span-2">
      <section class="wh-card-elevated p-6" aria-labelledby="space-list-title">
        <div class="flex flex-wrap justify-between items-center gap-3 mb-6">
          <h2 id="space-list-title" class="font-black text-xl m-0">
            Danh sách Không gian
          </h2>
          <button
            type="button"
            data-wh-click="openSpaceModal"
            class="wh-btn-brand text-xs uppercase tracking-widest relative z-10"
          >
            <span aria-hidden="true">+</span> Thêm mới
          </button>
        </div>
        <div class="wh-card-gradient overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-slate-50 text-xs uppercase text-slate-600 font-black tracking-widest">
                <tr>
                  <th scope="col" class="p-4">Tên / Mã</th>
                  <th scope="col" class="p-4">Loại</th>
                  <th scope="col" class="p-4">Trạng thái</th>
                  <th scope="col" class="p-4">Hành động</th>
                </tr>
              </thead>
              <tbody class="text-xs font-bold" id="spaces-list-body"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<div id="space-mgr-layer-3" class="hidden">
  <button
    type="button"
    data-wh-click="backToLayer2"
    class="wh-btn-outline mb-6 text-xs uppercase tracking-widest"
  >
    <span aria-hidden="true">←</span> Quay lại danh sách không gian
  </button>

  <div class="grid lg:grid-cols-3 gap-8">
    <div class="lg:col-span-1">
      <section class="wh-card-elevated p-6" aria-labelledby="detail-space-title">
        <h2 class="font-black text-xl mb-6" id="detail-space-title">
          Chi tiết không gian
        </h2>
        <div class="grid gap-4">
          <div>
            <p class="wh-label text-xs uppercase tracking-widest">
              Hình ảnh không gian
            </p>
            <div
              id="space-detail-img-container"
              class="flex flex-wrap gap-2 min-h-[50px] bg-slate-50 p-2 rounded-xl border border-slate-100 mb-2"
            ></div>
            <div id="space-detail-new-preview" class="flex flex-wrap gap-2"></div>
            <label
              for="space-img-input"
              class="wh-label text-xs uppercase tracking-widest cursor-pointer flex flex-col items-center justify-center gap-1 h-20 mt-2 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-600"
            >
              + Thêm nhiều ảnh phòng mới
              <input
                type="file"
                id="space-img-input"
                name="image"
                accept="image/*"
                multiple
                class="hidden"
                data-wh-change="previewNewSpaceDetailImages" data-wh-this="1"
              />
            </label>
          </div>

          <div>
            <label for="detail-space-price" class="wh-label text-xs uppercase tracking-widest">Giá niêm yết (/giờ)</label>
            <input
              type="number"
              id="detail-space-price"
              class="wh-field font-black"
            />
          </div>
          <div>
            <label for="detail-space-status" class="wh-label text-xs uppercase tracking-widest">Trạng thái</label>
            <select
              id="detail-space-status"
              class="wh-field font-bold"
            >
              <option value="ready">Sẵn sàng</option>
              <option value="suspended">Tạm ngừng hoạt động</option>
              <option value="maintenance">Bảo trì</option>
            </select>
          </div>

          <button
            type="button"
            data-wh-click="saveSpaceDetail"
            class="wh-btn-brand w-full text-xs uppercase tracking-widest"
          >
            Lưu chi tiết
          </button>
        </div>
      </section>
    </div>

    <div class="lg:col-span-2">
      <section class="wh-card-elevated p-6 h-full" aria-labelledby="space-schedule-title">
        <h2 id="space-schedule-title" class="font-black text-xl mb-6">
          Lịch đã được đặt
        </h2>
        <div class="wh-card-gradient overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-slate-50 text-xs uppercase text-slate-600 font-black tracking-widest">
                <tr>
                  <th scope="col" class="p-4">Khách hàng</th>
                  <th scope="col" class="p-4">Bắt đầu</th>
                  <th scope="col" class="p-4">Kết thúc</th>
                  <th scope="col" class="p-4">Trạng thái</th>
                </tr>
              </thead>
              <tbody class="text-xs" id="space-schedule-body"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<div
  id="modal-add-space"
  class="hidden fixed inset-0 bg-slate-900/60 backdrop-blur-sm items-center justify-center z-50 flex"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-add-space-title"
>
  <div class="bg-white w-full max-w-md p-6 rounded-[2rem] shadow-2xl border">
    <div class="flex justify-between items-center mb-4 border-b pb-2">
      <h2 id="modal-add-space-title" class="font-black text-lg uppercase tracking-tight m-0">
        Thêm Không Gian Mới
      </h2>
      <button
        type="button"
        data-wh-click="closeSpaceModal"
        aria-label="Đóng cửa sổ thêm không gian"
        class="text-slate-600 text-2xl font-bold p-1 bg-transparent border-none cursor-pointer"
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
    <form data-wh-submit="submitNewSpace" data-wh-event="1" class="grid gap-4">
      <div>
        <label for="modal-space-code" class="wh-label text-xs uppercase tracking-widest">Mã không gian</label>
        <input
          type="text"
          id="modal-space-code"
          placeholder="VD: MEETING-01"
          required
          class="wh-field"
        />
      </div>
      <div>
        <label for="modal-space-name" class="wh-label text-xs uppercase tracking-widest">Tên không gian</label>
        <input
          type="text"
          id="modal-space-name"
          placeholder="VD: Phòng hội nghị Lớn"
          required
          class="wh-field"
        />
      </div>
      <div>
        <label for="modal-space-category" class="wh-label text-xs uppercase tracking-widest">Loại hình</label>
        <select
          id="modal-space-category"
          class="wh-field"
        >
          <option>Phòng họp</option>
          <option>Chỗ ngồi tự do</option>
        </select>
      </div>
      <div>
        <label for="modal-space-price" class="wh-label text-xs uppercase tracking-widest">Giá thuê (/Giờ)</label>
        <input
          type="number"
          id="modal-space-price"
          placeholder="VD: 150000"
          required
          class="wh-field"
        />
      </div>
      <div>
        <label for="modal-space-img-input" class="wh-label text-xs uppercase tracking-widest">Hình ảnh không gian (Có thể chọn nhiều)</label>
        <input
          type="file"
          id="modal-space-img-input"
          name="image"
          accept="image/*"
          multiple
          data-wh-change="previewModalSpaceImage" data-wh-this="1"
          class="block w-full text-xs text-slate-600"
        />
        <div id="modal-space-img-preview" class="mt-2 flex flex-wrap gap-1"></div>
      </div>
      <div class="flex gap-2 pt-2">
        <button
          type="button"
          data-wh-click="closeSpaceModal"
          class="wh-btn-outline flex-1 text-xs uppercase tracking-widest"
        >
          Hủy
        </button>
        <button
          type="submit"
          class="wh-btn-brand flex-1 text-xs uppercase tracking-widest"
        >
          Xác nhận tạo
        </button>
      </div>
    </form>
  </div>
</div>
