<div class="flex flex-col gap-8">
    <header>
        <h1 class="wh-section-title">Báo cáo doanh thu</h1>
        <p class="wh-section-sub text-sm">Thống kê chi tiết dòng tiền theo thời gian cho chủ cơ sở của bạn</p>
    </header>

    <div id="report-notice" class="hidden mt-6 rounded-3xl border border-orange-200 bg-orange-50 px-6 py-4 text-sm font-medium text-orange-700" role="status" aria-live="polite"></div>

    <script>
    const reportNotice = document.getElementById('report-notice');

    function showReportNotice(message, type = 'error') {
      reportNotice.textContent = message;
      reportNotice.classList.remove('hidden', 'border-green-200', 'bg-green-50', 'text-green-700', 'border-orange-200', 'bg-orange-50', 'text-orange-700');

      if (type === 'success') {
        reportNotice.classList.add('border-green-200', 'bg-green-50', 'text-green-700');
      } else {
        reportNotice.classList.add('border-orange-200', 'bg-orange-50', 'text-orange-700');
      }
    }

    function clearReportNotice() {
      reportNotice.textContent = '';
      reportNotice.classList.add('hidden');
    }

    async function handleExport(exportUrl) {
      clearReportNotice();
      try {
        const response = await fetch(exportUrl);
        const contentType = response.headers.get('content-type');

        if (contentType && contentType.includes('application/json')) {
          const data = await response.json();
          showReportNotice(data.error || 'Lỗi xuất file', 'error');
          return;
        }

        if (response.ok) {
          const blob = await response.blob();
          const url = window.URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = `workhub-host-report-${new Date().toISOString().slice(0, 10)}.xlsx`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          window.URL.revokeObjectURL(url);
          showReportNotice('Xuất dữ liệu báo cáo thành công.', 'success');
        } else {
          showReportNotice('Lỗi xuất file. Vui lòng thử lại sau.', 'error');
        }
      } catch (error) {
        console.error('Export error:', error);
        showReportNotice('Lỗi xuất file. Vui lòng thử lại sau.', 'error');
      }
    }

    document.addEventListener('DOMContentLoaded', function() {
      const exportButton = document.getElementById('exportReportButton');
      if (exportButton) {
        exportButton.addEventListener('click', function() {
          handleExport(this.dataset.exportUrl);
        });
      }
    });
    </script>

    <form method="GET" action="/host/reports" class="wh-card-elevated p-5" aria-labelledby="report-filter-title">
        <h2 id="report-filter-title" class="wh-sr-only">Lọc báo cáo theo khoảng ngày</h2>
        <div class="grid gap-4 md:grid-cols-4 items-end">
            <div>
                <label for="report-start-date" class="wh-label text-xs uppercase tracking-widest">Từ ngày</label>
                <input type="date" id="report-start-date" name="startDate" value="<%= filters.startDate %>" class="wh-field">
            </div>
            <div>
                <label for="report-end-date" class="wh-label text-xs uppercase tracking-widest">Đến ngày</label>
                <input type="date" id="report-end-date" name="endDate" value="<%= filters.endDate %>" class="wh-field">
            </div>
            <button type="submit" class="wh-btn-brand w-full text-xs uppercase tracking-widest">Lọc dữ liệu</button>
            <button type="button" id="exportReportButton" data-export-url="<%= exportUrl %>" class="wh-btn-outline w-full text-xs uppercase tracking-widest">
                Xuất Excel
            </button>
        </div>
    </form>

    <script id="hostReportData" type="application/json"><%- JSON.stringify({ chartLabels: chartLabels || [], chartRevenueData: chartRevenueData || [] }) %></script>

    <section class="grid md:grid-cols-4 gap-6 wh-fade-up" aria-labelledby="report-kpi-title">
        <h2 id="report-kpi-title" class="wh-sr-only">Chỉ số tổng hợp</h2>

        <article class="report-card wh-stat">
            <p class="report-card-label wh-stat-label m-0">Tổng giá trị giao dịch (GMV)</p>
            <p class="report-card-value wh-stat-value m-0"><%= reportTotals.gmvText %>đ</p>
            <p class="report-card-note text-xs text-slate-600 mt-2 m-0">Tổng doanh thu đã xác nhận từ thanh toán online</p>
        </article>

        <article class="report-card wh-stat">
            <p class="report-card-label wh-stat-label m-0">Tiền cọc đã thu</p>
            <p class="report-card-value wh-stat-value m-0"><%= reportTotals.depositText %>đ</p>
            <p class="report-card-note text-xs text-slate-600 mt-2 m-0">Số tiền khách đã thanh toán online</p>
        </article>

        <article class="report-card wh-stat">
            <p class="report-card-label wh-stat-label m-0">Tổng nợ tại quầy</p>
            <p class="report-card-value wh-stat-value m-0"><%= reportTotals.outstandingText %>đ</p>
            <p class="report-card-note text-xs text-slate-600 mt-2 m-0">Số tiền còn lại khách thanh toán khi check-in</p>
        </article>

        <article class="report-card wh-stat">
            <p class="report-card-label wh-stat-label m-0">Doanh thu hủy</p>
            <p class="report-card-value wh-stat-value m-0"><%= reportTotals.cancelledText %>đ</p>
            <p class="report-card-note mt-2 m-0"><span class="wh-chip wh-chip-warning">Doanh thu bị huỷ trong kỳ chọn</span></p>
        </article>
    </section>

    <div class="grid lg:grid-cols-3 gap-6">
        <section class="lg:col-span-2 wh-card-elevated p-6" aria-labelledby="report-chart-title">
            <h2 id="report-chart-title" class="font-black text-sm uppercase tracking-widest mb-6">Biến động doanh thu</h2>
            <div class="h-[250px] bg-slate-50 rounded-2xl border border-slate-100 p-4">
                <% if (Array.isArray(chartLabels) && chartLabels.length > 0) { %>
                    <canvas id="revenueChart" class="w-full h-full"></canvas>
                <% } else { %>
                    <div class="h-full flex items-center justify-center">
                        <span class="text-sm font-medium text-slate-600">Biểu đồ sẽ hiển thị khi có dữ liệu thực tế</span>
                    </div>
                <% } %>
            </div>
        </section>

        <section class="lg:col-span-1 wh-card-elevated p-6" aria-labelledby="report-summary-title">
            <h2 id="report-summary-title" class="font-black text-sm uppercase tracking-widest mb-6">Tổng số booking</h2>
            <dl class="text-sm m-0">
                <div class="flex justify-between items-center gap-3 py-2 border-b border-slate-100">
                    <dt class="text-slate-600">Booking xác nhận</dt>
                    <dd class="font-black m-0"><%= reportTotals.totalBookings %></dd>
                </div>
                <div class="flex justify-between items-center gap-3 py-2 border-b border-slate-100">
                    <dt class="text-slate-600">Số không gian lọc</dt>
                    <dd class="font-black m-0"><%= reportTotals.totalSpaces %></dd>
                </div>
                <div class="flex justify-between items-center gap-3 py-2">
                    <dt class="text-slate-600">Chi nhánh chọn</dt>
                    <dd class="font-black m-0"><%= reportTotals.selectedBranchName %></dd>
                </div>
            </dl>
        </section>
    </div>

    <section aria-labelledby="report-performance-title">
        <h2 id="report-performance-title" class="font-black text-sm uppercase tracking-widest mb-4">Hiệu suất không gian</h2>
        <div class="wh-card-gradient overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-600 font-black tracking-widest">
                        <tr>
                            <th scope="col" class="p-4">Xếp hạng</th>
                            <th scope="col" class="p-4">Tên phòng/chỗ</th>
                            <th scope="col" class="p-4">Chi nhánh</th>
                            <th scope="col" class="p-4">Lượt đặt</th>
                            <th scope="col" class="p-4">Tỷ lệ lấp đầy</th>
                            <th scope="col" class="p-4">Tổng thu</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm font-bold text-slate-700">
                        <% if (performanceRows.length === 0) { %>
                            <tr>
                                <td colspan="6" class="p-6 text-center text-slate-600">Chưa có dữ liệu báo cáo</td>
                            </tr>
                        <% } else { %>
                            <% performanceRows.forEach(row => { %>
                                <tr class="border-b border-slate-100 hover:bg-slate-50 transition">
                                    <td class="p-4"><span class="inline-flex w-8 h-8 items-center justify-center rounded-full bg-slate-100 text-slate-600 text-xs font-black"><%= row.rank %></span></td>
                                    <td class="p-4"><%= row.spaceName %></td>
                                    <td class="p-4"><%= row.branchName %></td>
                                    <td class="p-4"><%= row.bookings %></td>
                                    <td class="p-4"><span class="wh-chip wh-chip-success"><%= row.fillRate %>%</span></td>
                                    <td class="p-4 font-black"><%= row.revenueText %>đ</td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

<script>
  (function() {
    const hostReportData = document.getElementById('hostReportData');
    const parsedData = hostReportData ? JSON.parse(hostReportData.textContent || '{}') : { chartLabels: [], chartRevenueData: [] };
    const labels = Array.isArray(parsedData.chartLabels) ? parsedData.chartLabels : [];
    const revenueData = Array.isArray(parsedData.chartRevenueData) ? parsedData.chartRevenueData : [];

    if (!labels.length || !revenueData.length) return;

    const ctx = document.getElementById('revenueChart');
    if (!ctx) return;

    new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: 'Doanh thu',
          data: revenueData,
          backgroundColor: 'rgba(34, 197, 94, 0.15)',
          borderColor: 'rgba(34, 197, 94, 1)',
          borderWidth: 2,
          fill: true,
          pointRadius: 3,
          pointBackgroundColor: 'rgba(34, 197, 94, 1)',
          tension: 0.35
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: { mode: 'index', intersect: false }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#475569', font: { size: 12 } }
          },
          y: {
            grid: { color: 'rgba(148, 163, 184, 0.15)' },
            ticks: {
              color: '#475569',
              font: { size: 12 },
              callback: function(value) {
                return new Intl.NumberFormat('vi-VN').format(value) + 'đ';
              }
            }
          }
        }
      }
    });
  })();
</script>
