<div class="flex flex-col gap-8">
    <header class="flex flex-wrap justify-between items-center gap-4">
        <div>
            <h1 class="wh-section-title">Bảng điều hành</h1>
            <p class="wh-section-sub text-sm">Theo dõi thời gian thực tình hình kinh doanh</p>
        </div>
        <a href="/host/reception" class="wh-btn-brand no-underline text-xs uppercase tracking-widest">
            <span aria-hidden="true">📷</span> Quét QR check-in
        </a>
    </header>

    <nav id="branch-tabs-container" class="flex flex-wrap gap-2 bg-white rounded-2xl p-1 border border-slate-100 shadow-sm" aria-label="Chọn cơ sở">
        <button type="button" class="branch-tab active px-5 py-2 rounded-xl text-sm font-bold" id="tab-all"
            data-wh-click="switchBranch" data-wh-args="[&quot;all&quot;]">Tất cả</button>
    </nav>

    <section class="grid md:grid-cols-4 gap-4 wh-fade-up" aria-labelledby="host-kpi-title">
        <h2 id="host-kpi-title" class="wh-sr-only">Chỉ số hôm nay</h2>

        <article class="wh-stat">
            <p class="wh-stat-label m-0">Tổng giá trị booking</p>
            <p class="wh-stat-value m-0" id="stat-revenue">0đ</p>
        </article>
        <article class="wh-stat">
            <p class="wh-stat-label m-0">Tổng đặt chỗ</p>
            <p class="wh-stat-value m-0" id="stat-bookings">0</p>
        </article>
        <article class="wh-stat">
            <p class="wh-stat-label m-0">Lượt khách đã dùng</p>
            <p class="wh-stat-value m-0" id="stat-occupied">0</p>
        </article>
        <article class="wh-stat">
            <p class="wh-stat-label m-0">Số chỗ đang hoạt động</p>
            <p class="wh-stat-value m-0" id="stat-rooms">0</p>
        </article>
    </section>

    <div class="grid lg:grid-cols-3 gap-6">
        <section class="lg:col-span-2 wh-card-elevated p-6" aria-labelledby="host-trend-title">
            <h2 id="host-trend-title" class="font-black text-sm uppercase tracking-widest mb-6">Xu hướng đặt chỗ</h2>
            <div class="relative h-72">
                <canvas id="bookingChart"></canvas>
            </div>
        </section>

        <section class="lg:col-span-1 wh-card-elevated p-6 flex flex-col" aria-labelledby="host-live-title">
            <h2 id="host-live-title" class="font-black text-sm uppercase tracking-widest mb-4">Trạng thái phòng live</h2>
            <div class="flex flex-wrap items-start gap-2 flex-1" id="host-floor-plan-mini"></div>
            <div class="mt-4 pt-4 border-t border-slate-100 flex flex-wrap gap-2">
                <span class="wh-chip wh-chip-success">Đang trống</span>
                <span class="wh-chip wh-chip-danger">Đang dùng</span>
                <span class="wh-chip wh-chip-warning">Sắp có khách</span>
            </div>
        </section>
    </div>

    <section aria-labelledby="host-recent-title">
        <h2 id="host-recent-title" class="font-black text-sm uppercase tracking-widest mb-4">Booking gần nhất</h2>
        <div class="wh-card-gradient overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50 text-xs uppercase text-slate-600 font-black tracking-widest">
                        <tr>
                            <th scope="col" class="p-3">Khách</th>
                            <th scope="col" class="p-3">Phòng / Chỗ</th>
                            <th scope="col" class="p-3">Thời gian đặt</th>
                            <th scope="col" class="p-3">Trạng thái đơn</th>
                        </tr>
                    </thead>
                    <tbody class="text-xs text-slate-600" id="host-recent-table"></tbody>
                </table>
            </div>
        </div>
    </section>

    <section class="wh-card-elevated p-6" aria-labelledby="host-cashflow-title">
        <h2 id="host-cashflow-title" class="font-black text-lg mb-4">Chi tiết dòng tiền</h2>
        <dl class="text-sm m-0">
            <div class="flex flex-wrap justify-between items-center gap-3 py-3 border-b border-slate-100">
                <dt class="font-bold text-slate-700">Tổng giá trị booking</dt>
                <dd class="m-0"><span class="wh-chip wh-chip-success text-sm" id="finance-paid">0đ</span></dd>
            </div>
            <div class="flex flex-wrap justify-between items-center gap-3 py-3">
                <dt class="font-medium text-slate-600">Đã thanh toán (đặt cọc)</dt>
                <dd class="m-0"><span class="wh-chip wh-chip-warning text-sm" id="finance-pending">0đ</span></dd>
            </div>
        </dl>
    </section>
</div>

<%/* Chart.js comes from layout.ejs (loadChartJs) with the CSP nonce;
     the unnonced jsdelivr tag here was blocked in production.
     host-dashboard.js is injected via scriptsFrom in app.js. */%>

<div id="page-indicator">Trang: <span id="current-page-label">Trang Chủ</span></div>

<div id="success-toast"
    class="fixed top-10 left-1/2 -translate-x-1/2 bg-green-600 text-white px-8 py-3 rounded-full shadow-2xl z-[100] hidden"
    role="status" aria-live="polite" aria-atomic="true">
    <div class="flex items-center gap-3 font-bold">
        <span id="toast-msg">Thành công!</span>
    </div>
</div>

<div id="modal-qr"
    class="fixed inset-0 bg-slate-900/60 z-[100] hidden flex-col items-center justify-center backdrop-blur-sm"
    role="dialog" aria-modal="true" aria-labelledby="modal-qr-title">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
            <h2 id="modal-qr-title" class="font-black text-lg uppercase tracking-tighter m-0">Quét mã QR check-in</h2>
            <button type="button" data-wh-click="closeModal" data-wh-args="[&quot;modal-qr&quot;]"
                aria-label="Đóng cửa sổ quét QR"
                class="text-slate-600 font-bold text-2xl leading-none bg-transparent border-none cursor-pointer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="p-8 text-center bg-slate-800">
            <div class="relative w-full h-72 mx-auto mb-6 bg-slate-900 rounded-3xl border-2 border-teal-500 flex items-center justify-center overflow-hidden">
                <p class="text-on-dark-muted font-bold text-xs uppercase tracking-widest m-0">Đưa QR vào khung</p>
            </div>
            <button type="button" data-wh-click="closeModal" data-wh-args="[&quot;modal-qr&quot;]" data-wh-then="showToast"
                data-wh-then-args="[&quot;Check-in thành công cho mã đơn BK-9902!&quot;]"
                class="wh-btn-brand w-full text-xs uppercase tracking-widest">
                [Demo] Bấm để giả lập quét
            </button>
        </div>
    </div>
</div>

<div id="modal-add-space"
    class="fixed inset-0 bg-slate-900/60 z-[100] hidden flex-col items-center justify-center backdrop-blur-sm"
    role="dialog" aria-modal="true" aria-labelledby="modal-add-space-title">
    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-md overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50">
            <h2 id="modal-add-space-title" class="font-black text-lg uppercase tracking-tighter m-0">Thêm không gian mới</h2>
            <button type="button" data-wh-click="closeModal" data-wh-args="[&quot;modal-add-space&quot;]"
                aria-label="Đóng cửa sổ thêm không gian"
                class="text-slate-600 font-bold text-2xl leading-none bg-transparent border-none cursor-pointer">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
        <div class="p-6 grid gap-4">
            <div>
                <label for="dash-space-name" class="wh-label text-xs uppercase tracking-widest">Tên/Mã không gian</label>
                <input type="text" id="dash-space-name" placeholder="VD: Phòng họp 103" class="wh-field">
            </div>
            <div>
                <label for="dash-space-image" class="wh-label text-xs uppercase tracking-widest cursor-pointer flex items-center justify-center h-20 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-600">
                    + Chọn ảnh minh họa
                    <input type="file" id="dash-space-image" accept="image/*" class="hidden">
                </label>
            </div>
            <div class="grid md:grid-cols-2 gap-4">
                <div>
                    <label for="dash-space-type" class="wh-label text-xs uppercase tracking-widest">Loại</label>
                    <select id="dash-space-type" class="wh-field">
                        <option>Phòng họp</option>
                        <option>Chỗ ngồi tự do</option>
                    </select>
                </div>
                <div>
                    <label for="dash-space-price" class="wh-label text-xs uppercase tracking-widest">Giá niêm yết / giờ</label>
                    <input type="number" id="dash-space-price" placeholder="250000" class="wh-field">
                </div>
            </div>
            <div>
                <label for="dash-space-status" class="wh-label text-xs uppercase tracking-widest">Trạng thái</label>
                <select id="dash-space-status" class="wh-field">
                    <option value="ready">Sẵn sàng</option>
                    <option value="preparing">Đang chuẩn bị</option>
                    <option value="occupied">Có khách</option>
                    <option value="suspended">Tạm ngừng hoạt động</option>
                </select>
            </div>
            <button type="button" data-wh-click="closeModal" data-wh-args="[&quot;modal-add-space&quot;]"
                data-wh-then="showToast" data-wh-then-args="[&quot;Đã thêm không gian mới!&quot;]"
                class="wh-btn-brand w-full text-xs uppercase tracking-widest">
                Lưu không gian
            </button>
        </div>
    </div>
</div>

<%/* main.js and host-spaces.js are injected by app.js through
     res.locals.scriptsFrom([...]), which adds the CSP nonce. Loading them
     again here duplicated both bundles on this page. */%>
