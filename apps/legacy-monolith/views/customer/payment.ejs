<%/* Payment confirmation.

     public/js/customer-main.js drives this page: setPaymentType() toggles the
     `active` class on #pay-30 / #pay-100, reveals #qr-area, hides
     #qr-placeholder and writes the figure into #qr-price-val. The ids, the
     data-wh-* attributes and the `payment-card` class are the contract and are
     unchanged.

     Fixed here:
       - the two payment options were <div>s with a click handler: not
         focusable, not operable from the keyboard, and announced as plain text.
         They are now <button type="button"> inside a radiogroup-style list,
         which keeps the same delegated handler (ui-bind resolves it with
         closest('[data-wh-click]')) and adds keyboard operation.
       - the "back" control was a bare button with no type, so it could submit
         an enclosing form.

     Cascade note: #qr-area and #qr-placeholder are shown/hidden by class, and
     the purged utilities are emitted before brand.css in app.min.css — so
     neither may carry a wh- class that declares `display`. */%>

<div class="max-w-4xl">
    <button type="button" data-wh-click="goBackToDetail" class="text-sm font-bold mb-4" style="color: var(--color-text-soft);">← QUAY LẠI THÔNG TIN</button>

    <h1 class="wh-section-title mb-2">Xác nhận thanh toán</h1>
    <p id="hold-countdown" class="text-sm font-bold mb-6 hidden" style="color: var(--color-highlight-dark);" role="status" aria-live="polite"></p>

    <div class="grid md:grid-cols-2 gap-8">
        <section aria-labelledby="pay-options-title">
            <h2 id="pay-options-title" class="wh-stat-label mb-3">Chọn mức thanh toán</h2>

            <button type="button" id="pay-30" data-wh-click="setPaymentType" data-wh-args="[&quot;deposit&quot;]"
                    class="payment-card wh-card-elevated w-full text-left p-6 mb-4"
                    style="border-width: 2px;">
                <span class="flex justify-between items-center gap-4">
                    <span class="font-bold text-lg" style="color: var(--color-text);">Đặt cọc (30%)</span>
                    <span class="wh-stat-value" id="pay-txt-30">--</span>
                </span>
            </button>

            <button type="button" id="pay-100" data-wh-click="setPaymentType" data-wh-args="[&quot;full&quot;]"
                    class="payment-card wh-card-elevated w-full text-left p-6"
                    style="border-width: 2px;">
                <span class="flex justify-between items-center gap-4">
                    <span class="font-bold text-lg" style="color: var(--color-text);">Toàn bộ (100%)</span>
                    <span class="wh-stat-value" id="pay-txt-100">--</span>
                </span>
            </button>
        </section>

        <section class="wh-card-elevated p-8 text-center flex flex-col justify-center min-h-[350px]" aria-labelledby="pay-qr-title">
            <h2 id="pay-qr-title" class="wh-sr-only">Mã QR chuyển khoản</h2>

            <div id="qr-area" class="hidden">
                <img id="qr-img" src="" alt="Mã QR chuyển khoản cho đơn đặt chỗ" width="176" height="176"
                     loading="lazy" decoding="async" class="mx-auto w-44 mb-4 border p-2 rounded-lg">
                <p class="wh-stat-label mb-1">Số tiền cần chuyển</p>
                <p class="wh-stat-value mb-6" id="qr-price-val" aria-live="polite">0đ</p>
                <button type="button" data-wh-click="handleFinalSuccess" class="wh-btn-brand w-full uppercase text-xs tracking-widest">
                    TÔI ĐÃ CHUYỂN KHOẢN
                </button>
            </div>

            <p id="qr-placeholder" class="italic" style="color: var(--color-muted);">Vui lòng chọn mức thanh toán để nhận mã QR</p>
        </section>
    </div>
</div>
