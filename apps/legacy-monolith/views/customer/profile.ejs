<%/* Customer profile. public/js/customer-main.js reads every field by id
     (input-fullname, input-phone, input-bank-name, input-bank-number,
     input-avatar, profile-avatar-preview, profile-display-name) and the save
     button is wired through its data-wh-click binding — none of those hooks
     change here.

     The detail card uses wh-card-gradient rather than wh-card-elevated: the
     elevated card lifts on :focus-within, which on a form of text inputs would
     shift the layout on every focus change. */%>

<h1 class="wh-section-title mb-8">Hồ sơ Khách hàng</h1>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 max-w-6xl">

  <section class="lg:col-span-1">
    <div class="wh-card-elevated p-8 text-center">
      <div class="relative w-28 mx-auto mb-4">
        <div class="rounded-full overflow-hidden" style="border: 4px solid var(--color-primary-50); background: var(--color-primary-100);">
          <img id="profile-avatar-preview" name="avatar" src="https://ui-avatars.com/api/?name=User&size=200" alt="" aria-hidden="true" width="200" height="200" loading="lazy" decoding="async" class="w-full object-cover">
        </div>

        <%/* The label is the visible control for the hidden file input, so it
             carries both `for` and a text alternative. */%>
        <label for="input-avatar" class="absolute wh-touch-target inline-flex items-center justify-center rounded-full cursor-pointer shadow-lg" style="bottom: 0; right: 0; background: var(--color-primary-fill); color: var(--color-on-primary);">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            <path d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="wh-sr-only">Chọn ảnh đại diện</span>
          <input type="file" id="input-avatar" class="hidden" accept="image/*" data-wh-change="previewProfileImage" data-wh-this="1">
        </label>
      </div>

      <h2 id="profile-display-name" class="text-xl font-bold mt-2" style="color: var(--color-text);">--</h2>
      <p class="wh-chip wh-chip-brand mt-2">Khách hàng</p>
    </div>
  </section>

  <section class="lg:col-span-2">
    <div class="wh-card-gradient shadow-md p-8">
      <h2 class="text-lg font-black mb-6 flex items-center gap-2" style="color: var(--color-text);">
        <span aria-hidden="true">📝</span> Thông tin chi tiết
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <div>
          <label for="input-fullname" class="wh-label">Họ và tên</label>
          <input type="text" id="input-fullname" placeholder="Nhập họ và tên..." class="wh-field" autocomplete="name">
        </div>

        <div>
          <label for="input-email" class="wh-label">Email đăng nhập</label>
          <input type="email" id="input-email" class="wh-field" autocomplete="email" disabled>
        </div>

        <div>
          <label for="input-phone" class="wh-label">Số điện thoại liên hệ</label>
          <input type="text" id="input-phone" placeholder="Nhập số điện thoại..." class="wh-field" autocomplete="tel">
        </div>

        <div>
          <label for="input-bank-name" class="wh-label">Tên ngân hàng</label>
          <input type="text" id="input-bank-name" placeholder="VD: Vietcombank, TPBank..." class="wh-field">
        </div>

        <div class="md:col-span-2">
          <label for="input-bank-number" class="wh-label">Số tài khoản ngân hàng</label>
          <input type="text" id="input-bank-number" placeholder="Nhập số tài khoản..." class="wh-field">
        </div>

      </div>

      <div class="mt-8 pt-6 border-t flex justify-end">
        <button type="button" data-wh-click="saveMyProfile" class="wh-btn-brand">
          Lưu thay đổi
        </button>
      </div>
    </div>
  </section>

</div>
