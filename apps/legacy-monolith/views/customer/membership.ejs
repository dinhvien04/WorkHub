<%/* Membership. #mem-current, #mem-plans and #mem-credits are rendered by
     public/js/membership.js — the shell below must keep those ids. */%>

<div class="max-w-3xl mx-auto">
  <header class="mb-6">
    <h1 class="wh-section-title mb-2">Membership</h1>
    <p class="wh-section-sub text-sm">Gói giờ co-working theo tháng · sổ credit</p>
  </header>

  <div id="mem-current" class="mb-6" aria-live="polite"></div>

  <section class="mb-8">
    <h2 class="text-lg font-bold mb-3" style="color: var(--color-text);">Gói khả dụng</h2>
    <div id="mem-plans" class="grid md:grid-cols-2 gap-4"></div>
  </section>

  <section class="wh-card-elevated p-5 wh-fade-up">
    <h2 class="text-lg font-bold mb-2" style="color: var(--color-text);">Lịch sử credit</h2>
    <p class="text-xs mb-3" style="color: var(--color-muted);">Ledger giờ membership (cộng / trừ).</p>
    <ul id="mem-credits" class="space-y-2 text-sm"></ul>
  </section>
</div>
