<%/* Booking history.
     public/js/customer-history.js owns everything dynamic here. Hooks that must
     survive any restyle:
       - #custom-time-btn / #custom-time-menu — the menu is shown by removing
         `hidden` and then `opacity-0 scale-95`, so all three tokens stay.
       - .time-option-btn — the script swaps `text-teal-600` / `text-slate-700`
         on these, so both classes stay on every option.
       - #md-remaining — its *parent element* is the box the script toggles
         between `hidden` and `flex`, so that element keeps both classes and
         stays the direct parent.
       - #star-container label — the script reassigns `label.className`
         wholesale, so those labels keep exactly the classes it writes back.
       - #modal-detail-content, #modal-booking-detail, and the data-wh-click
         close buttons. */%>

<h1 class="wh-section-title mb-6">Lịch sử đặt chỗ</h1>

<%/* Toolbar: wh-card-gradient, not wh-card-elevated — the elevated card lifts
     on :focus-within and would nudge the whole bar the moment the search field
     takes focus, dragging the open dropdown with it. */%>
<div class="wh-card-gradient shadow-sm p-3 md:p-4 mb-8 flex justify-end items-center w-full relative z-10">
    <div class="flex flex-col md:flex-row gap-3 w-full items-center">

        <div class="relative inline-block text-left" id="custom-time-dropdown">
            <button type="button" id="custom-time-btn" class="wh-btn-outline text-sm w-full">
                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                <span id="custom-time-text">Tất cả thời gian</span>
            </button>

            <%/* A plain raised surface, not wh-card-elevated: that component
                 lifts on hover, which on an open menu would slide the options
                 out from under the pointer. */%>
            <div id="custom-time-menu" class="hidden absolute z-50 mt-2 overflow-hidden bg-white border rounded-2xl shadow-xl" style="left: 0; top: 100%; width: 14rem;">
                <div class="py-2 flex flex-col">
                    <button type="button" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold text-teal-600 hover:bg-slate-50" data-value="all">Tất cả thời gian</button>
                    <button type="button" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50" data-value="specific">Ngày cụ thể...</button>
                    <button type="button" class="time-option-btn w-full text-left px-5 py-3 text-sm font-bold text-slate-700 hover:bg-slate-50" data-value="range">Khoảng thời gian...</button>
                </div>
            </div>
        </div>

        <%/* Off-screen date pickers driven by the dropdown above; the script
             calls showPicker() on them. They are still real controls, so they
             still get labels. */%>
        <div class="absolute overflow-hidden" style="width: 0; height: 0; opacity: 0; pointer-events: none;">
            <label class="wh-sr-only" for="filter-date-1">Từ ngày</label>
            <input type="date" id="filter-date-1">
            <label class="wh-sr-only" for="filter-date-2">Đến ngày</label>
            <input type="date" id="filter-date-2">
        </div>

        <div class="flex items-center gap-2 w-full">
            <label class="wh-sr-only" for="filter-keyword">Tìm theo tên cơ sở hoặc mã đơn</label>
            <input type="text" id="filter-keyword" placeholder="Tìm tên cơ sở, mã đơn..." class="wh-field flex-1">
            <button type="button" aria-label="Tìm kiếm" class="wh-btn-brand flex-shrink-0">
                <svg width="16" height="16" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </button>
        </div>
    </div>
</div>

<div class="space-y-4 max-w-5xl" id="history-list" aria-live="polite"></div>

<div id="modal-booking-detail" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Chi tiết đặt chỗ">
    <div class="wh-card-gradient shadow-2xl w-full max-w-xl overflow-y-auto overflow-hidden no-scrollbar" id="modal-detail-content" style="max-height: 90vh;">

        <div class="relative" style="background: var(--color-surface-sunken);">
            <img id="md-img" src="" class="wh-media w-full" alt="Ảnh không gian" loading="lazy" decoding="async" style="border-radius: 0;">

            <%/* Scrim so the overlaid title keeps its contrast whatever the
                 photo behind it looks like. */%>
            <div class="absolute inset-0" aria-hidden="true" style="background: linear-gradient(180deg, rgba(15,23,42,0.15) 0%, rgba(15,23,42,0.78) 100%);"></div>

            <button data-wh-click="closeModal" data-wh-args="[&quot;modal-booking-detail&quot;]" type="button" class="absolute rounded-full bg-white font-black shadow-md" style="top: 1rem; right: 1rem; color: var(--color-text);" aria-label="Đóng">
                <span aria-hidden="true">&times;</span>
            </button>

            <div class="absolute text-white" style="bottom: 1rem; left: 1.5rem; right: 1.5rem;">
                <h2 id="md-space-name" class="font-black text-2xl tracking-tight">Tên không gian</h2>
                <p id="md-space-code" class="text-sm font-bold mt-1 text-on-dark">Mã phòng: --</p>
            </div>
        </div>

        <div class="p-6">
            <section class="mb-6 space-y-2 p-4 rounded-xl border" style="background: var(--color-surface-sunken);">
                <h3 class="text-xs font-black uppercase mb-1" style="color: var(--color-muted);">Thông tin liên hệ</h3>
                <p class="flex items-start gap-2 text-sm font-medium" style="color: var(--color-text-soft);">
                    <span aria-hidden="true">📍</span> <span id="md-branch-address">Địa chỉ: --</span>
                </p>
                <p class="flex items-start gap-2 text-sm font-bold" style="color: var(--color-primary-text);">
                    <span aria-hidden="true">📞</span> <span id="md-branch-hotline">Hotline: --</span>
                </p>
            </section>

            <dl class="space-y-2 mb-6">
                <div class="flex justify-between items-center border-b pb-3 gap-2">
                    <dt class="font-bold uppercase text-xs" style="color: var(--color-muted);">Mã đơn hàng</dt>
                    <dd id="md-booking-id" class="font-black px-3 py-1 rounded-lg m-0" style="color: var(--color-text); background: var(--color-surface-sunken);">#...</dd>
                </div>
                <div class="flex justify-between items-center border-b pb-3 gap-2">
                    <dt class="font-bold uppercase text-xs" style="color: var(--color-muted);">Thời gian đặt</dt>
                    <dd id="md-time-created" class="font-bold text-xs m-0" style="color: var(--color-text-soft);">...</dd>
                </div>
                <div class="flex justify-between items-center border-b pb-3 gap-2">
                    <dt class="font-bold uppercase text-xs" style="color: var(--color-muted);">Thời gian sử dụng</dt>
                    <dd id="md-time" class="font-black text-xs text-right m-0" style="color: var(--color-primary-text);">...</dd>
                </div>
            </dl>

            <div class="flex justify-between items-end mb-4 gap-4">
                <div>
                    <p class="wh-stat-label mb-1">Tổng chi phí</p>
                    <p id="md-total" class="text-2xl font-black" style="color: var(--color-text);">0đ</p>
                </div>
                <div class="text-right">
                    <p class="wh-stat-label mb-1">Đã cọc</p>
                    <p id="md-deposit" class="text-sm font-black" style="color: var(--color-success-text);">0đ</p>
                </div>
            </div>

            <%/* customer-history.js toggles `hidden` / `flex` on this element —
                 the direct parent of #md-remaining — so both stay put. */%>
            <%/* Neutral tray behind the chip: wh-chip-danger already paints its
                 own danger tint, and sitting it on the same tint would erase
                 it. */%>
            <div class="flex justify-between items-center p-4 rounded-xl mb-6 gap-3" style="background: var(--color-surface-sunken);">
                <span class="wh-chip wh-chip-danger">Còn phải trả</span>
                <span id="md-remaining" class="text-xl font-black" style="color: var(--color-danger-text);">0đ</span>
            </div>

            <a href="#" id="md-link-detail" class="wh-btn-brand w-full">Xem trang cơ sở</a>
        </div>
    </div>
</div>

<div id="modal-review" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Đánh giá trải nghiệm">
    <div class="wh-card-gradient shadow-2xl w-full max-w-md overflow-hidden p-8 relative">
        <button data-wh-click="closeModal" data-wh-args="[&quot;modal-review&quot;]" type="button" class="absolute rounded-full font-black text-xl" style="top: 0.75rem; right: 0.75rem; color: var(--color-muted); background: transparent;" aria-label="Đóng">
            <span aria-hidden="true">&times;</span>
        </button>

        <h2 class="font-black text-xl mb-2" style="color: var(--color-text);">Đánh giá trải nghiệm</h2>
        <p class="text-xs font-medium mb-6" style="color: var(--color-muted);">Bạn có thể chỉnh sửa đánh giá trong vòng 7 ngày.</p>

        <form id="review-form">
            <input type="hidden" id="rv-booking-id">

            <%/* customer-history.js rewrites label.className on click, so these
                 labels keep exactly the class strings it writes back. The
                 for/id pairing and the screen-reader text sit outside className
                 and survive the rewrite. */%>
            <fieldset class="m-0 p-0 border-none mb-6">
                <legend class="wh-sr-only">Số sao</legend>
                <div class="flex justify-center gap-2" id="star-container">
                    <label for="rv-star-1" class="cursor-pointer text-4xl text-slate-200 hover:text-amber-400 transition"><input type="radio" id="rv-star-1" name="rating" value="1" class="hidden" required>★<span class="wh-sr-only">1 sao</span></label>
                    <label for="rv-star-2" class="cursor-pointer text-4xl text-slate-200 hover:text-amber-400 transition"><input type="radio" id="rv-star-2" name="rating" value="2" class="hidden">★<span class="wh-sr-only">2 sao</span></label>
                    <label for="rv-star-3" class="cursor-pointer text-4xl text-slate-200 hover:text-amber-400 transition"><input type="radio" id="rv-star-3" name="rating" value="3" class="hidden">★<span class="wh-sr-only">3 sao</span></label>
                    <label for="rv-star-4" class="cursor-pointer text-4xl text-slate-200 hover:text-amber-400 transition"><input type="radio" id="rv-star-4" name="rating" value="4" class="hidden">★<span class="wh-sr-only">4 sao</span></label>
                    <label for="rv-star-5" class="cursor-pointer text-4xl text-amber-400 transition"><input type="radio" id="rv-star-5" name="rating" value="5" class="hidden" checked>★<span class="wh-sr-only">5 sao</span></label>
                </div>
            </fieldset>

            <label class="wh-label" for="rv-comment">Nhận xét của bạn</label>
            <textarea id="rv-comment" class="wh-field mb-6" rows="3" placeholder="Nhận xét của bạn..."></textarea>

            <button type="submit" class="wh-btn-brand w-full uppercase">Gửi đánh giá</button>
        </form>
    </div>
</div>

<style>
    /* Ẩn thanh cuộn Chrome, Safari, Edge */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    /* Ẩn thanh cuộn Firefox & IE */
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>

<script src="/js/customer-history.js"></script>
