<%/* Notifications. public/js/notifications.js fills #notif-list and toggles
     `ring-2`, `ring-teal-500` and `bg-teal-50` on the filter buttons to mark
     the active one, so those three classes are left for the script to own and
     the buttons deliberately do not use .wh-chip — the brand layer ships after
     the utilities and would win over the toggled background. */%>

<div class="max-w-2xl mx-auto">
  <header class="flex flex-wrap items-center justify-between gap-3 mb-4">
    <div>
      <h1 class="wh-section-title mb-1">Thông báo</h1>
      <p class="wh-section-sub text-sm">
        Booking, thanh toán và tin nhắn ·
        <span id="notif-unread-label" class="font-bold" style="color: var(--color-primary-text);">0 chưa đọc</span>
      </p>
    </div>
    <button type="button" id="notif-read-all" class="wh-btn-outline text-xs uppercase">Đánh dấu đã đọc</button>
  </header>

  <div class="flex flex-wrap gap-2 mb-4" id="notif-filters" role="group" aria-label="Lọc thông báo">
    <button type="button" data-filter="all" class="text-xs font-black uppercase px-3 py-2 rounded-full border ring-2 ring-teal-500">Tất cả</button>
    <button type="button" data-filter="unread" class="text-xs font-black uppercase px-3 py-2 rounded-full border">Chưa đọc</button>
    <button type="button" data-filter="booking" class="text-xs font-black uppercase px-3 py-2 rounded-full border">Booking</button>
    <button type="button" data-filter="payment" class="text-xs font-black uppercase px-3 py-2 rounded-full border">Thanh toán</button>
    <button type="button" data-filter="message" class="text-xs font-black uppercase px-3 py-2 rounded-full border">Tin nhắn</button>
    <button type="button" data-filter="system" class="text-xs font-black uppercase px-3 py-2 rounded-full border">Hệ thống</button>
  </div>

  <div id="notif-list" class="space-y-2" aria-live="polite"></div>
</div>
