<%/* Customer dashboard.
     Every list body is filled by public/js/dashboard.js, so the markup here is
     the static shell only: headings, section surfaces and the QR modal. The
     ids below are all bound in that file — none of them may change. */%>

<div class="max-w-3xl mx-auto">
  <header class="mb-6">
    <h1 class="wh-section-title mb-2" data-i18n="dash.title">Tổng quan</h1>
    <p class="wh-section-sub text-sm" data-i18n="dash.subtitle">Booking sắp tới, việc cần làm và thanh toán chờ xác minh.</p>
  </header>

  <div id="dash-counts" class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6"></div>

  <section class="wh-card-elevated p-5 mb-4 wh-fade-up">
    <h2 class="text-lg font-bold mb-2" data-i18n="dash.checkin" style="color: var(--color-text);">Check-in hôm nay</h2>
    <p class="text-xs mb-3" style="color: var(--color-muted);">Mã QR ngắn hạn (30 phút). Host quét tại lễ tân hoặc nhập mã WH-xxxxxx.</p>
    <div id="dash-checkin" class="space-y-2 text-sm"></div>
  </section>

  <section class="wh-card-elevated p-5 mb-4 wh-fade-up">
    <h2 class="text-lg font-bold mb-3" data-i18n="booking.action_required" style="color: var(--color-text);">Cần xử lý</h2>
    <div id="dash-action" class="space-y-2 text-sm"></div>
  </section>

  <section class="wh-card-elevated p-5 mb-4 wh-fade-up">
    <h2 class="text-lg font-bold mb-3" data-i18n="booking.upcoming" style="color: var(--color-text);">Sắp tới</h2>
    <div id="dash-upcoming" class="space-y-2 text-sm"></div>
  </section>

  <section class="wh-card-elevated p-5 mb-4 wh-fade-up">
    <h2 class="text-lg font-bold mb-3" style="color: var(--color-text);">Thanh toán chờ host</h2>
    <div id="dash-pay" class="space-y-2 text-sm"></div>
  </section>
</div>

<%/* Check-in QR modal. dashboard.js toggles `hidden`/`flex` on the wrapper, so
     both classes stay in place. */%>
<div id="dash-qr-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-slate-900/60 backdrop-blur-sm p-4" role="dialog" aria-modal="true" aria-label="Check-in QR">
  <div class="wh-card-gradient shadow-2xl w-full max-w-md p-6 text-center relative">
    <button type="button" id="dash-qr-close" class="absolute top-3 right-3 rounded-full bg-slate-100 font-bold" aria-label="Đóng">
      <span aria-hidden="true">&times;</span>
    </button>

    <h2 class="text-lg font-black mb-1" data-i18n="booking.checkin_qr" style="color: var(--color-text);">Mã check-in</h2>
    <p id="dash-qr-title" class="text-sm mb-3" style="color: var(--color-muted);"></p>

    <img id="dash-qr-img" alt="Mã QR check-in" width="200" height="200" loading="lazy" decoding="async" class="mx-auto rounded-xl border mb-3">

    <p id="dash-qr-code" class="text-2xl font-black tracking-widest mb-1" style="color: var(--color-primary-text);"></p>
    <p id="dash-qr-exp" class="text-xs mb-3" style="color: var(--color-muted);"></p>

    <button type="button" id="dash-qr-copy" class="wh-btn-outline text-xs uppercase">Copy token</button>
  </div>
</div>
