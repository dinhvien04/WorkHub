<%/* Favourites. public/js/favorites.js owns #fav-list and #fav-error, so this
     file only supplies the shell — the skeleton keeps the grid height reserved
     until the first paint of real cards. */%>

<div class="max-w-4xl mx-auto">
  <header class="mb-6">
    <h1 class="wh-section-title mb-2">Yêu thích</h1>
    <p class="wh-section-sub text-sm">Danh sách cơ sở bạn đã lưu. Guest có thể lưu tạm rồi gộp sau khi đăng nhập.</p>
  </header>

  <div id="fav-error" class="error-state hidden mb-4" role="alert"></div>

  <div id="fav-list" class="grid md:grid-cols-2 gap-4" aria-live="polite">
    <div class="skeleton h-48"></div>
  </div>
</div>
