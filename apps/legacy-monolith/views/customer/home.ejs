<%/* Landing page.
     Contrast notes, since several pairs here previously failed WCAG AA:
       - the search CTA was amber-500 with white text (~1.9:1). Amber now
         carries near-black text, which is how the colour stays vivid and
         still reads.
       - rating stars were amber-500 on white (~2.2:1) and secondary meta was
         slate-400 (~2.8:1). Both moved to tokens that measure above 4.5:1.
     The hero image is the LCP element, so it gets fetchpriority and an
     explicit box to keep it out of CLS. */%>

<section class="wh-hero wh-aurora-animated mb-10">
    <img src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=1600"
        class="absolute inset-0 w-full h-full object-cover"
        style="z-index: -2;"
        alt=""
        aria-hidden="true"
        width="1600"
        height="900"
        fetchpriority="high"
        loading="eager"
        decoding="async">

    <div class="relative text-center">
        <h1 class="wh-hero-title">Tìm kiếm không gian làm việc</h1>
        <p class="wh-hero-sub mx-auto mb-6">Linh hoạt, tiện nghi và chuyên nghiệp</p>

        <form action="/search" method="GET" role="search"
            class="bg-white/95 p-2 rounded-2xl shadow-xl flex gap-2 max-w-xl mx-auto border border-teal-100/50 transition-shadow duration-300 focus-within:shadow-2xl">
            <label for="home-search-location" class="wh-sr-only">Địa điểm bạn muốn làm việc</label>
            <input
                id="home-search-location"
                type="text"
                name="location"
                placeholder="Bạn muốn làm việc ở đâu?"
                class="flex-1 px-4 py-3 text-slate-800 rounded-xl text-sm border-none bg-transparent"
                autocomplete="off">
            <%/* Amber at full saturation needs dark text to reach AA. */%>
            <button type="submit"
                class="px-6 py-2.5 rounded-xl font-black text-sm transition-transform duration-200 hover:scale-[1.02] active:scale-95"
                style="background: var(--color-highlight); color: #1f1300;">
                TÌM KIẾM
            </button>
        </form>
    </div>
</section>

<h2 class="wh-section-title mb-6 wh-fade-up">
    Cơ sở <span class="wh-gradient-text">nổi bật</span>
</h2>

<div class="grid md:grid-cols-3 gap-6">
    <% if (branches && branches.length > 0) { %>
        <% branches.forEach((branch, _idx) => { %>
            <article class="wh-card-elevated p-4 flex flex-col wh-fade-up" style="transition-delay: <%= Math.min(_idx * 60, 300) %>ms">

                <div class="wh-media-zoom rounded-xl mb-4">
                    <%/* wh-media sets aspect-ratio, so the box exists before the
                         image arrives and late loads cannot shift the grid. */%>
                    <img
                        src="<%= (branch.Images && branch.Images.length > 0) ? branch.Images[0] : '/icons/icon.svg' %>"
                        class="wh-media"
                        alt="<%= branch.Name %>"
                        loading="lazy"
                        decoding="async">
                </div>

                <div class="flex-1">
                    <h3 class="font-bold text-lg" style="color: var(--color-text);">
                        <%= branch.Name %>
                    </h3>

                    <p class="text-sm mt-2" style="color: var(--color-muted);">
                        <span aria-hidden="true">📍</span> <%= branch.Address %>
                    </p>

                    <% if (branch.Description) { %>
                        <p class="text-sm mt-3 line-clamp-2" style="color: var(--color-text-soft);">
                            <%= branch.Description %>
                        </p>
                    <% } %>

                    <p class="text-xs mt-3" style="color: var(--color-muted);">
                        <span aria-hidden="true">🕒</span> <%= branch.OpeningTime %> – <%= branch.ClosingTime %>
                    </p>

                    <p class="flex items-center gap-1 text-sm mt-2 font-semibold" style="color: var(--color-highlight-dark);">
                        <span aria-hidden="true">⭐</span>
                        <span class="wh-sr-only">Đánh giá</span><%= branch.RatingAvg || 0 %>/5
                    </p>

                    <% if (branch.priceFrom != null) { %>
                    <p class="text-sm font-black mt-2" style="color: var(--color-primary-text);">
                        Từ <%= Number(branch.priceFrom).toLocaleString('vi-VN') %>đ/giờ
                    </p>
                    <% } %>

                    <% if (branch.hasInstantBook) { %>
                    <span class="wh-chip wh-chip-brand mt-2">Instant book</span>
                    <% } %>
                </div>

                <%
                  const _href = branch.Slug
                    ? '/khong-gian/' + (branch.CitySlug || 'viet-nam') + '/' + (branch.DistrictSlug || 'khu-vuc') + '/' + branch.Slug
                    : '/detail?branchId=' + branch._id;
                %>
                <a href="<%= _href %>" class="wh-btn-outline w-full mt-4">
                    Xem chi tiết<span class="wh-sr-only"> <%= branch.Name %></span>
                </a>
            </article>
        <% }) %>
    <% } else { %>
        <div class="col-span-3 text-center py-16 wh-fade-up">
            <div class="text-6xl mb-4 animate-float" aria-hidden="true">🏢</div>
            <p class="text-lg font-medium" style="color: var(--color-text-soft);">
                Hiện chưa có cơ sở nào hoạt động.
            </p>
            <p class="text-sm mt-2" style="color: var(--color-muted);">Hãy quay lại sau nhé!</p>
        </div>
    <% } %>
</div>

<section id="home-newest" class="hidden mt-12 wh-fade-up">
  <h2 class="wh-section-title mb-4">Mới trên WorkHub</h2>
  <div data-newest-list class="flex gap-3 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth"></div>
</section>
