<%/* Payment history.

     Restyled onto the wh- design system. The EJS is byte-for-byte the same
     logic; only markup and classes moved.

     Fixed here:
       - "Từ ngày" and "Trạng thái" had labels with no `for=` and their
         controls had no id, so neither was announced. Both controls keep their
         `name` (the GET form is what the controller reads) and gain an id.
       - the "Thất bại" badge was `bg-green-50 text-red-500` — a green pill for
         a failure. Status now uses .wh-chip-{success,danger} so the tint and
         the text agree, and each carries its own word, never colour alone.
       - the table could not scroll on a narrow viewport; it now sits in its own
         overflow-x container.

     The trailing inline <script> is left exactly as it was found. */%>

<h1 class="wh-section-title mb-6">Lịch sử thanh toán</h1>

<form action="/payment_history" method="GET" class="wh-card-elevated p-6 mb-8" aria-labelledby="ph-filter-title">
    <h2 id="ph-filter-title" class="wh-stat-label mb-4">Bộ lọc giao dịch</h2>

    <div class="grid md:grid-cols-4 gap-4 items-end">

        <div class="md:col-span-2">
            <label for="branch-select" class="wh-label text-xs uppercase font-black">Tìm theo cơ sở</label>
            <select name="branchKeyword" id="branch-select" class="wh-field text-sm">
                <option value="">Tất cả cơ sở</option>
                <% if (typeof allSpaces !== 'undefined' && allSpaces.length > 0) { %>
                    <% allSpaces.forEach(space => { %>
                        <option value="<%= space.name %>" <%= (typeof filters !== 'undefined' && filters.branchKeyword === space.name) ? 'selected' : '' %>>
                            <%= space.name %>
                        </option>
                    <% }) %>
                <% } %>
            </select>
        </div>

        <div>
            <label for="ph-start-date" class="wh-label text-xs uppercase font-black">Từ ngày</label>
            <input type="date" id="ph-start-date" name="startDate" value="<%= (typeof filters !== 'undefined' && filters.startDate) ? filters.startDate : '' %>" class="wh-field text-sm">
        </div>

        <div>
            <label for="ph-status-filter" class="wh-label text-xs uppercase font-black">Trạng thái</label>
            <select name="statusFilter" id="ph-status-filter" class="wh-field text-sm">
                <% let currentStatus = (typeof filters !== 'undefined' && filters.statusFilter) ? filters.statusFilter : 'Tất cả'; %>
                <option value="Tất cả" <%= currentStatus === 'Tất cả' ? 'selected' : '' %>>Tất cả</option>
                <option value="Thành công" <%= currentStatus === 'Thành công' ? 'selected' : '' %>>Thành công</option>
                <option value="Thất bại" <%= currentStatus === 'Thất bại' ? 'selected' : '' %>>Thất bại</option>
            </select>
        </div>

    </div>

    <div class="flex justify-end mt-4">
        <button type="submit" class="wh-btn-brand text-xs uppercase tracking-widest">ÁP DỤNG</button>
    </div>
</form>

<section class="wh-card-elevated overflow-hidden" aria-labelledby="ph-table-title">
    <h2 id="ph-table-title" class="wh-sr-only">Danh sách giao dịch</h2>

    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="border-b" style="background: var(--color-surface-sunken);">
                    <th scope="col" class="p-5 text-xs uppercase font-black" style="color: var(--color-muted);">Ngày giao dịch</th>
                    <th scope="col" class="p-5 text-center text-xs uppercase font-black" style="color: var(--color-muted);">Giờ</th>
                    <th scope="col" class="p-5 text-xs uppercase font-black" style="color: var(--color-muted);">Tên cơ sở</th>
                    <th scope="col" class="p-5 text-xs uppercase font-black" style="color: var(--color-muted);">Số tiền</th>
                    <th scope="col" class="p-5 text-center text-xs uppercase font-black" style="color: var(--color-muted);">Ghi chú</th>
                    <th scope="col" class="p-5 text-xs uppercase font-black" style="color: var(--color-muted);">Trạng thái</th>
                </tr>
            </thead>
            <tbody class="text-sm">
                <% if (typeof payments !== 'undefined' && payments && payments.length > 0) { %>
                    <% payments.forEach(item => { %>
                        <tr class="border-b hover:bg-slate-50">
                            <td class="p-5 font-medium" style="color: var(--color-text-soft);">
                                <%= item.createdAt ? new Date(item.createdAt).toLocaleDateString('vi-VN') : '—' %>
                            </td>
                            <td class="p-5 text-center font-bold text-xs" style="color: var(--color-muted);">
                                <%= item.createdAt ? new Date(item.createdAt).toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' }) : '—' %>
                            </td>
                            <td class="p-5 font-bold" style="color: var(--color-text);">
                                <%= (item.BookingID && item.BookingID.SpaceID && (item.BookingID.SpaceID.Name || item.BookingID.SpaceID.name))
                                    ? (item.BookingID.SpaceID.Name || item.BookingID.SpaceID.name)
                                    : 'WorkHub Space' %>
                            </td>
                            <td class="p-5 font-black whitespace-nowrap" style="color: var(--color-primary-text);">
                                <%= item.Amount ? item.Amount.toLocaleString('vi-VN') : '0' %>đ
                            </td>
                            <td class="p-5 text-center">
                                <span class="wh-chip wh-chip-info">
                                <% if (item.PaymentType === 'deposit') { %>
                                    Đặt cọc (30%)
                                <% } else if (item.PaymentType === 'full_payment') { %>
                                    Thanh toán 100%
                                <% } else if (item.PaymentType === 'remaining_balance') { %>
                                    Thanh toán nốt (70%)
                                <% } else { %>
                                    <%= item.PaymentType || 'Thanh toán' %>
                                <% } %>
                                </span>
                            </td>
                            <td class="p-5">
                                <% if (item.Status === 'successful') { %>
                                    <span class="wh-chip wh-chip-success">Thành công</span>
                                <% } else if (item.Status === 'failed') { %>
                                    <span class="wh-chip wh-chip-danger">Thất bại</span>
                                <% } else { %>
                                    <span class="wh-chip">Chờ xử lý</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr><td colspan="6" class="empty-state">Không có dữ liệu giao dịch.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const branchSelect = document.getElementById('branch-select');

        if (branchSelect) {
            new Choices(branchSelect, {
                searchEnabled: true,
                searchChoices: true,
                itemSelectText: 'Nhấn để chọn',
                noResultsText: 'Không tìm thấy chi nhánh',
                shouldSort: false,
                position: 'bottom',
                placeholder: true,
                placeholderValue: 'Chọn chi nhánh...'
            });
        }
    });
</script>
