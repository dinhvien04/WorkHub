<%/* Booking detail.

     Restyled onto the wh- design system. Everything public/js/booking-detail.js
     binds to is load-bearing and unchanged: the bd-* ids, the section ids it
     toggles `hidden` on, and the amber utility classes on #bd-hold — the hold
     countdown swaps those for `text-red-700 bg-red-50 border-red-100` when the
     hold lapses, so the base classes have to stay in that family.

     Cascade note: app.min.css emits the purged utilities *before* brand.css, so
     `.wh-btn-brand{display:inline-flex}` beats `.hidden{display:none}`. Any
     element the page script shows/hides by class therefore keeps a button style
     that declares no `display` (.btn-primary) instead. #bd-pay-link previously
     carried `hidden inline-block` and was visible on every booking for the same
     reason — that is fixed here.

     Also fixed: the refund and dispute controls sat inside wrapper <label>s with
     no `for=`, and the check-in QR image had an empty alt and no loading hint. */%>

<div class="max-w-2xl mx-auto">
  <a href="/history" class="text-sm font-bold hover:underline" style="color: var(--color-primary-text);">← Lịch sử đặt</a>
  <h1 class="wh-section-title mt-2 mb-1">Chi tiết booking</h1>
  <p id="bd-id" class="text-xs mb-4" style="color: var(--color-muted);"></p>

  <div id="bd-error" class="error-state hidden mb-4" role="alert"></div>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-summary-title">
    <h2 id="bd-summary-title" class="wh-stat-label mb-2">Tóm tắt đặt chỗ</h2>
    <div id="bd-summary" class="space-y-2 text-sm" style="color: var(--color-text-soft);"></div>
    <p id="bd-hold" class="hidden mt-3 text-sm font-bold text-amber-700 bg-amber-50 border border-amber-100 rounded-xl px-3 py-2" role="status" aria-live="polite"></p>
    <div id="bd-policy" class="mt-3 text-xs border-t pt-2" style="color: var(--color-muted);"></div>
  </section>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-pay-title">
    <h2 id="bd-pay-title" class="wh-stat-label mb-2">Thanh toán</h2>
    <p id="bd-pay" class="text-sm font-bold" style="color: var(--color-text);"></p>
    <div class="flex flex-wrap items-center gap-2 mt-4">
      <a id="bd-pay-link" href="#" class="hidden btn-primary text-xs uppercase tracking-widest no-underline"
         style="border-radius: var(--radius-full); padding: 0.75rem 1.4rem;">Thanh toán / cọc</a>
      <a id="bd-receipt" href="#" class="hidden text-xs font-black uppercase tracking-widest no-underline"
         style="border: 2px solid var(--color-primary); border-radius: var(--radius-full); padding: 0.7rem 1.4rem; color: var(--color-primary-text);">Biên lai</a>
    </div>
  </section>

  <section id="bd-reschedule-section" class="wh-card-elevated p-5 mb-4 hidden" aria-labelledby="bd-rs-title">
    <h2 id="bd-rs-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Đổi lịch</h2>
    <p class="text-xs mb-4" style="color: var(--color-muted);">Server kiểm tra chỗ trống trước; chỉ áp dụng khi khung giờ mới free. Slot cũ không giải phóng nếu giữ slot mới thất bại.</p>
    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div>
        <label class="wh-label text-xs uppercase font-black" for="bd-rs-start">Bắt đầu (ISO local)</label>
        <input id="bd-rs-start" type="datetime-local" class="wh-field text-sm" />
      </div>
      <div>
        <label class="wh-label text-xs uppercase font-black" for="bd-rs-end">Kết thúc</label>
        <input id="bd-rs-end" type="datetime-local" class="wh-field text-sm" />
      </div>
    </div>
    <div class="flex flex-wrap gap-2 mb-2">
      <button type="button" id="bd-rs-preview" class="wh-btn-outline text-xs uppercase tracking-widest">Xem trước</button>
      <button type="button" id="bd-rs-apply" class="wh-btn-brand text-xs uppercase tracking-widest" disabled>Áp dụng đổi lịch</button>
    </div>
    <div id="bd-rs-preview-box" class="text-sm space-y-2" style="color: var(--color-text-soft);"></div>
    <p id="bd-rs-msg" class="text-sm mt-2" role="status"></p>
  </section>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-timeline-title">
    <h2 id="bd-timeline-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Timeline</h2>
    <ol id="bd-timeline" class="space-y-2 text-sm" style="color: var(--color-text-soft);"></ol>
  </section>

  <section id="bd-checkin-section" class="wh-card-elevated p-5 mb-4 hidden" aria-labelledby="bd-qr-title">
    <h2 id="bd-qr-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Check-in QR</h2>
    <p class="text-xs mb-4" style="color: var(--color-muted);">Mã ngắn hạn cho lễ tân. Chỉ hiện khi booking confirmed/in-use.</p>
    <div class="flex flex-wrap gap-3 items-center">
      <button type="button" id="bd-qr-btn" class="wh-btn-brand text-xs uppercase tracking-widest">Tạo mã QR</button>
      <span id="bd-qr-code" class="text-xl font-black tracking-widest" style="color: var(--color-primary-text);"></span>
    </div>
    <img id="bd-qr-img" alt="Mã QR check-in của booking" width="180" height="180"
         loading="lazy" decoding="async" class="mt-4 hidden rounded-xl border" />
    <p id="bd-qr-exp" class="text-xs mt-2" style="color: var(--color-muted);"></p>
  </section>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-cal-title">
    <h2 id="bd-cal-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Lịch</h2>
    <div class="flex flex-wrap gap-2">
      <a id="bd-gcal" target="_blank" rel="noopener" class="wh-btn-outline text-xs uppercase tracking-widest no-underline">Google</a>
      <a id="bd-outlook" target="_blank" rel="noopener" class="wh-btn-outline text-xs uppercase tracking-widest no-underline">Outlook</a>
      <a id="bd-ics" class="wh-btn-outline text-xs uppercase tracking-widest no-underline">ICS</a>
    </div>
  </section>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-support-title">
    <h2 id="bd-support-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Tin nhắn &amp; hỗ trợ</h2>
    <div class="flex flex-wrap gap-2">
      <a id="bd-messages" href="/messages" class="wh-btn-outline text-xs uppercase tracking-widest no-underline">Tin nhắn booking</a>
      <a href="/support" class="wh-btn-outline text-xs uppercase tracking-widest no-underline">Gửi ticket</a>
    </div>
  </section>

  <section id="bd-refund-section" class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-refund-title">
    <h2 id="bd-refund-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Yêu cầu hoàn tiền</h2>
    <p id="bd-refund-help" class="text-xs mb-4" style="color: var(--color-muted);">Số tiền ≤ số đã thanh toán còn lại (net paid − hoàn đang chờ). Bắt buộc Idempotency-Key.</p>
    <div class="grid md:grid-cols-2 gap-4 mb-4">
      <div>
        <label class="wh-label text-xs uppercase font-black" for="bd-refund-amount">Số tiền (VND)</label>
        <input id="bd-refund-amount" type="number" min="1000" step="1000" inputmode="numeric"
               class="wh-field text-sm" aria-describedby="bd-refund-help" />
      </div>
      <div>
        <label class="wh-label text-xs uppercase font-black" for="bd-refund-reason">Lý do</label>
        <input id="bd-refund-reason" maxlength="1000" placeholder="Lý do hoàn" class="wh-field text-sm" />
      </div>
    </div>
    <button type="button" id="bd-refund-btn" class="wh-btn-brand wh-btn-accent text-xs uppercase tracking-widest">
      Gửi yêu cầu hoàn
    </button>
    <p id="bd-refund-msg" class="text-sm mt-2" role="status"></p>
    <ul id="bd-refund-list" class="mt-4 space-y-2 text-xs" style="color: var(--color-text-soft);"></ul>
  </section>

  <section id="bd-dispute-section" class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-dispute-title">
    <h2 id="bd-dispute-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Mở tranh chấp (dispute)</h2>
    <p class="text-xs mb-4" style="color: var(--color-muted);">Khi thanh toán / hoàn tiền / chất lượng dịch vụ có vấn đề chưa giải quyết.</p>
    <label class="wh-label text-xs uppercase font-black" for="bd-dispute-reason">Lý do (tối thiểu 5 ký tự)</label>
    <textarea id="bd-dispute-reason" rows="3" maxlength="2000" class="wh-field text-sm mb-4" placeholder="Mô tả chi tiết…"></textarea>
    <button type="button" id="bd-dispute-btn" class="wh-btn-outline text-xs uppercase tracking-widest">
      Mở dispute
    </button>
    <p id="bd-dispute-msg" class="text-sm mt-2" role="status"></p>
  </section>

  <section class="wh-card-elevated p-5 mb-4" aria-labelledby="bd-cancel-title">
    <h2 id="bd-cancel-title" class="font-bold text-lg mb-2" style="color: var(--color-text);">Hủy đặt chỗ</h2>
    <p id="bd-cancel-preview" class="text-sm mb-4" style="color: var(--color-text-soft);"></p>
    <button type="button" id="bd-cancel-btn" class="wh-btn-brand text-xs uppercase tracking-widest"
      style="background: var(--color-danger); box-shadow: none;">
      Hủy booking
    </button>
    <p id="bd-cancel-msg" class="text-sm mt-2" role="status"></p>
  </section>
</div>
